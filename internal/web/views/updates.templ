package views

import (
	"context"
	"fmt"
	"net/url"
	"sort"
)

// UpdatesActions is what the user may do from the updates pages.
type UpdatesActions struct {
	CSRF       string
	CanOperate bool
	CanAdmin   bool
	CanUpdate  bool // may open the Hangar update page (owner)
	SudoActive bool
}

// UpdatesData feeds the "Updates and vulnerabilities" page (docs/14): the
// services with what is pending in each, the riskiest first.
type UpdatesData struct {
	UpdatesActions
	Running   bool
	LastRun   string // "há 2 h"; "" = never
	LastError bool
	// Filters of the list: an action (bucket), a severity, a search.
	Bucket   string
	Sev      string
	Query    string
	Filtered bool
	Cards    []BucketCard
	Services []VulnServiceRow
	Total    int    // services matching the filters
	From     int    // 1-based first row when this is a later "Load more" page; 0 on the first
	NextHref string // the next "Load more" ("" = no more)
	// Empty: nothing pending at all.
	Empty        bool
	IgnoredCount int
	Ignores      []IgnoreRow
	Problems     []ScanProblem
	Error        string
	Flash        string
}

// Filters are the list's filters as a query (for the chips and "Load
// more").
func (d UpdatesData) Filters() url.Values {
	q := url.Values{}
	if d.Bucket != "" {
		q.Set("bucket", d.Bucket)
	}
	if d.Sev != "" {
		q.Set("sev", d.Sev)
	}
	if d.Query != "" {
		q.Set("q", d.Query)
	}
	return q
}

// filterHref is the list with one filter set to v (or cleared when it is
// already v: a chip toggles), the others kept.
func (d UpdatesData) filterHref(key, v string) string {
	q := d.Filters()
	if q.Get(key) == v {
		q.Del(key)
	} else {
		q.Set(key, v)
	}
	if s := q.Encode(); s != "" {
		return "/updates?" + s
	}
	return "/updates"
}

// VulnServiceRow is one service (or the server's own image) in the list.
type VulnServiceRow struct {
	Key      string // "lab/web", "edge"
	Label    string // "lab/web", "servidor · Caddy"
	Project  string // "" for the server
	Source   string // its image or repository
	Repo     bool
	Href     string // its page
	Export   string // its copy button
	Sev      []SevCount
	Actions  []ActionCount
	Total    int
	LastScan string
	// ScanError: its last inventory could not read everything.
	ScanError bool
}

// SevCount is how many advisories of one severity.
type SevCount struct {
	Sev string
	N   int
}

// ActionCount is how many rows of one bucket.
type ActionCount struct {
	Bucket string
	N      int
}

// UpdatesTargetData feeds one service's page: its rows by what to do.
type UpdatesTargetData struct {
	UpdatesActions
	Running     bool
	Label       string
	Source      string
	Repo        bool
	ServiceHref string // the service on its project ("" for the server)
	Path        string // this page
	Export      string
	LastScan    string
	ScanError   string
	Scanned     bool
	Sev         []SevCount
	Cards       []BucketCard
	Sections    []UpdatesSection
	// Bucket is the one section asked for (a "Load more" page).
	Bucket       string
	Empty        bool
	IgnoredCount int
	Error        string
	Flash        string
}

// BucketCard is a counter at the top: rows of one bucket.
type BucketCard struct {
	Bucket string
	Count  int
}

// UpdatesSection is one bucket's card on a service's page.
type UpdatesSection struct {
	Bucket   string
	Rows     []GroupRow
	Total    int
	Export   string
	From     int    // 1-based first row on a later page; 0 on the first
	NextHref string // the next "Load more" ("" = no more)
}

// Row actions.
const (
	ActDeploy  = "deploy"  // "Deploy" (operator)
	ActHangar  = "hangar"  // "Update Hangar" (owner)
	ActTag     = "tag"     // "Switch to <tag>" (admin + sudo)
	ActCommand = "command" // the exact command for the app's code
	ActAdvice  = "advice"  // a text, with Code when there is something to copy
	ActBadge   = "badge"   // why it waits
)

// GroupRow is one row: the findings one action deals with.
type GroupRow struct {
	ID        string
	IDs       []string
	Severity  string // critical, high, medium, low, unknown; "" for tag updates
	Kind      string // tag updates: patch, minor, major
	Where     string
	Href      string
	Project   string
	Service   string
	Packages  string // "zlib, expat, libx11", "stdlib (gosu)", "imagem nginx"
	Ecosystem string // second line: "Alpine 3.23", "Python · uv", "66 graves · 43 outras"
	Current   string
	Fixed     string
	// Count and Advisories are the distinct advisories (none for tag
	// updates).
	Count      int
	Advisories []AdvisoryRow
	Action     string
	Tag        string // ActTag
	Code       string // ActCommand, ActAdvice
	Text       string // ActAdvice, ActBadge
	// IgnoreVersion is the "until a newer version" choice ("" = none).
	IgnoreVersion string
}

// AdvisoryRow is one advisory in a row's list.
type AdvisoryRow struct {
	ID       string
	URL      string
	Aliases  string
	Summary  string
	Severity string
	Package  string
	Current  string
	Fixed    string
}

// IgnoreRow is an ignore rule in force.
type IgnoreRow struct {
	ID       string
	Where    string
	Package  string
	Advisory string
	Until    string
	Reason   string
}

// ScanProblem is a target whose inventory could not read everything.
type ScanProblem struct {
	Where    string
	Href     string
	Detail   string
	Packages int
}

// ServiceVulns is the vulnerability summary on a service's Visão tab.
type ServiceVulns struct {
	Sev      []SevCount
	Actions  []ActionCount
	Total    int
	Href     string
	Export   string
	LastScan string
	Scanned  bool
}

// SortScanProblems orders problems by place.
func SortScanProblems(p []ScanProblem) {
	sort.Slice(p, func(i, j int) bool { return p[i].Where < p[j].Where })
}

// sevBadge: critical and high in red, medium in yellow, the rest plain.
func sevBadge(sev string) string {
	switch sev {
	case "critical", "high":
		return "tuc-badge is-danger"
	case "medium":
		return "tuc-badge is-warning"
	}
	return "tuc-badge"
}

// bucketTone is the color of a card's number.
func bucketTone(b string) string {
	switch b {
	case "deploy":
		return "text-danger"
	case "tag":
		return "text-warning"
	case "code":
		return "text-info"
	}
	return ""
}

// chipClass is a filter chip, pressed or not.
func chipClass(on bool) string {
	if on {
		return "tuc-btn is-outline is-sm border-accent bg-accent-soft"
	}
	return "tuc-btn is-ghost is-sm"
}

// updatesSevChips are the severity filters (no "unknown": it is noise).
var updatesSevChips = []string{"critical", "high", "medium", "low"}

// updatesActionChips are the action filters, in page order.
var updatesActionChips = []string{"deploy", "tag", "code", "wait", "updates"}

// Updates is the updates and vulnerabilities page: the services.
templ Updates(d UpdatesData) {
	@shell(t(ctx, "deps.page_title")) {
		if d.Running {
			// ui.js reloads once the scan is over (data-busy-poll).
			<span hidden data-busy-poll></span>
		}
		@pageHead(t(ctx, "deps.title"), d.subtitle(ctx)) {
			if !d.Empty {
				<button type="button" class="tuc-btn is-outline" data-copy-url="/updates/export" data-copied={ t(ctx, "common.copied") } data-copy-failed={ t(ctx, "deps.export.copy_failed") } title={ t(ctx, "deps.export.copy_all_hint") }>
					@Icon("copy", "size-3.5")
					{ t(ctx, "deps.export.copy_all") }
				</button>
			}
			if d.CanOperate {
				@scanButton(d.CSRF, d.Running)
			}
		}
		@pageBody() {
			@errorAlert(d.Error)
			@toast("success", d.Flash)
			<div class="flex flex-wrap gap-3">
				for _, c := range d.Cards {
					<a class={ "flex flex-[1_1_180px] flex-col gap-0.5 rounded-md border bg-surface px-4 py-3.5 text-fg no-underline hover:border-border-strong", templ.KV("border-accent bg-accent-soft", d.Bucket == c.Bucket), templ.KV("border-border", d.Bucket != c.Bucket) } href={ templ.SafeURL(d.filterHref("bucket", c.Bucket)) } aria-current?={ d.Bucket == c.Bucket }>
						<span class="text-xs text-muted">{ t(ctx, "deps.bucket." + c.Bucket) }</span>
						<span class={ "text-[22px] leading-[30px] font-semibold tabular-nums " + bucketTone(c.Bucket) }>{ fmt.Sprint(c.Count) }</span>
						<span class="text-xs text-subtle">{ t(ctx, "deps.bucket_sub." + c.Bucket) }</span>
					</a>
				}
			</div>
			if d.Empty && !d.Filtered && len(d.Services) == 0 {
				<section class={ cardClass }>
					<div class={ cardBodyClass }>
						if d.LastRun == "" {
							@emptyState("shield", t(ctx, "deps.never_scanned"))
						} else {
							@emptyState("shield-check", t(ctx, "deps.empty"))
						}
					</div>
				</section>
			} else {
				@servicesCard(d)
			}
			if d.IgnoredCount > 0 {
				<p class="m-0 text-xs text-muted">{ t(ctx, "deps.ignored_count", "n", d.IgnoredCount) }</p>
			}
			if len(d.Problems) > 0 {
				<section class={ cardClass }>
					@cardHead(t(ctx, "deps.problems"))
					<div class={ cardBodyClass }>
						@notice("warning", "triangle-alert", t(ctx, "deps.problems_hint"))
						<ul class="m-0 flex list-none flex-col gap-2 p-0">
							for _, p := range d.Problems {
								<li class="flex items-center gap-2.5">
									@Icon("triangle-alert", "size-4 text-warning")
									<div class="flex min-w-0 flex-col">
										<a class="font-mono text-xs text-fg no-underline hover:text-accent-text hover:underline" href={ templ.SafeURL(p.Href) }>{ p.Where }</a>
										<span class="truncate font-mono text-[11px] text-subtle" title={ p.Detail }>{ p.Detail }</span>
									</div>
								</li>
							}
						</ul>
					</div>
				</section>
			}
			if len(d.Ignores) > 0 {
				@ignoresCard(d)
			}
		}
	}
}

templ scanButton(csrf string, running bool) {
	<form method="post" action="/updates/scan">
		<input type="hidden" name="csrf" value={ csrf }/>
		<button class="tuc-btn is-primary" type="submit" disabled?={ running }>
			if running {
				<span class="tuc-spinner" aria-hidden="true"></span>
				{ t(ctx, "deps.scanning") }
			} else {
				@Icon("refresh-cw", "size-3.5")
				{ t(ctx, "deps.scan_now") }
			}
		</button>
	</form>
}

// servicesCard is the list: filters on top, one row per service, "Load
// more" at the end (ui.js appends the next rows; without it the link
// opens them).
templ servicesCard(d UpdatesData) {
	<section class={ cardClass } id="svc-list" data-more-list>
		@cardHead(t(ctx, "deps.svc.list_title")) {
			<span class="text-xs text-muted tabular-nums">{ t(ctx, "deps.svc.count", "n", d.Total) }</span>
		}
		<div class={ cardBodyClass }>
			<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
				<form class="relative min-w-0 flex-[1_1_240px] max-w-[360px]" method="get" action="/updates" role="search">
					if d.Bucket != "" {
						<input type="hidden" name="bucket" value={ d.Bucket }/>
					}
					if d.Sev != "" {
						<input type="hidden" name="sev" value={ d.Sev }/>
					}
					@Icon("search", "pointer-events-none absolute top-1/2 left-2.5 size-3.5 -translate-y-1/2 text-muted")
					<input class="tuc-input w-full pl-8" type="search" name="q" value={ d.Query } maxlength="100" placeholder={ t(ctx, "deps.svc.search") } aria-label={ t(ctx, "deps.svc.search") } autocomplete="off"/>
				</form>
				<div class="flex flex-wrap items-center gap-1" role="group" aria-label={ t(ctx, "deps.col.severity") }>
					for _, s := range updatesSevChips {
						<a class={ chipClass(d.Sev == s) } href={ templ.SafeURL(d.filterHref("sev", s)) } aria-pressed={ fmt.Sprint(d.Sev == s) }>{ t(ctx, "deps.chip." + s) }</a>
					}
				</div>
				<div class="flex flex-wrap items-center gap-1" role="group" aria-label={ t(ctx, "deps.svc.col_actions") }>
					for _, b := range updatesActionChips {
						<a class={ chipClass(d.Bucket == b) } href={ templ.SafeURL(d.filterHref("bucket", b)) } aria-pressed={ fmt.Sprint(d.Bucket == b) }>{ t(ctx, "deps.bucket." + b) }</a>
					}
				</div>
				if d.Filtered {
					<a class="tuc-btn is-ghost is-sm" href="/updates">
						@Icon("x", "size-3.5")
						{ t(ctx, "deps.show_all") }
					</a>
				}
			</div>
			if d.From > 0 {
				<span class="text-xs text-muted tabular-nums">{ t(ctx, "pagination.range", "from", d.From, "to", d.From+len(d.Services)-1, "total", d.Total) }</span>
			}
			if len(d.Services) == 0 {
				<p class="m-0 text-[13px] text-subtle">{ t(ctx, "deps.svc.no_match") }</p>
			} else {
				<div class="tuc-table-wrap">
					<table class="tuc-table is-compact w-full min-w-[820px]">
						<thead>
							<tr>
								<th>{ t(ctx, "deps.svc.col_service") }</th>
								<th>{ t(ctx, "deps.col.severity") }</th>
								<th>{ t(ctx, "deps.svc.col_actions") }</th>
								<th>{ t(ctx, "deps.svc.col_scan") }</th>
								<th class="tuc-table__actions"></th>
							</tr>
						</thead>
						<tbody data-more-items>
							for _, s := range d.Services {
								@serviceRow(s)
							}
						</tbody>
					</table>
				</div>
				@loadMore(d.NextHref)
			}
		</div>
	</section>
}

templ serviceRow(s VulnServiceRow) {
	<tr>
		<td class="max-w-[360px]">
			<span class="flex min-w-0 items-center gap-2.5">
				<span class="inline-flex size-7 shrink-0 items-center justify-center rounded-sm border border-border bg-surface-2 text-muted" aria-hidden="true">
					if s.Project == "" {
						@Icon("server", "size-3.5")
					} else if s.Repo {
						@Icon("git-branch", "size-3.5")
					} else {
						@Icon("container", "size-3.5")
					}
				</span>
				<span class="flex min-w-0 flex-col">
					<a class="truncate font-mono text-xs text-fg no-underline hover:text-accent-text hover:underline" href={ templ.SafeURL(s.Href) }>{ s.Label }</a>
					if s.Source != "" {
						<span class="truncate font-mono text-[11px] text-subtle" title={ s.Source }>{ s.Source }</span>
					}
				</span>
			</span>
		</td>
		<td>
			if len(s.Sev) > 0 {
				@sevBadges(s.Sev)
			} else if s.Total == 0 {
				<span class="inline-flex items-center gap-1 text-xs text-success">
					@Icon("shield-check", "size-3.5")
					{ t(ctx, "deps.svc.clean") }
				</span>
			} else {
				<span class="text-xs text-muted">—</span>
			}
		</td>
		<td>
			@actionBadges(s.Actions)
		</td>
		<td class="whitespace-nowrap text-xs text-muted">
			<span class="inline-flex items-center gap-1">
				if s.ScanError {
					<span class="inline-flex text-warning" role="img" title={ t(ctx, "deps.svc.scan_error") } aria-label={ t(ctx, "deps.svc.scan_error") }>
						@Icon("triangle-alert", "size-3.5")
					</span>
				}
				if s.LastScan != "" {
					{ s.LastScan }
				} else {
					{ t(ctx, "deps.svc.never") }
				}
			</span>
		</td>
		<td class="tuc-table__actions">
			<span class="inline-flex items-center justify-end gap-1.5">
				if s.Total > 0 {
					<button type="button" class="tuc-btn is-ghost is-sm" data-copy-url={ s.Export } data-copied={ t(ctx, "common.copied") } data-copy-failed={ t(ctx, "deps.export.copy_failed") } title={ t(ctx, "deps.svc.copy_hint", "where", s.Label) } aria-label={ t(ctx, "deps.svc.copy_hint", "where", s.Label) }>
						@Icon("copy", "size-3.5")
						{ t(ctx, "deps.copy") }
					</button>
				}
				<a class="tuc-btn is-ghost is-icon is-sm" href={ templ.SafeURL(s.Href) } aria-label={ t(ctx, "deps.svc.open", "where", s.Label) } title={ t(ctx, "deps.svc.open", "where", s.Label) }>
					@Icon("chevron-right", "size-4")
				</a>
			</span>
		</td>
	</tr>
}

templ sevBadges(sev []SevCount) {
	<span class="inline-flex flex-wrap items-center gap-1">
		for _, c := range sev {
			<span class={ sevBadge(c.Sev) }>{ t(ctx, "deps.sev_n." + c.Sev, "n", c.N) }</span>
		}
	</span>
}

templ actionBadges(acts []ActionCount) {
	if len(acts) == 0 {
		<span class="text-xs text-muted">—</span>
	} else {
		<span class="inline-flex flex-wrap items-center gap-1">
			for _, a := range acts {
				<span class="tuc-badge">{ t(ctx, "deps.act_n." + a.Bucket, "n", a.N) }</span>
			}
		</span>
	}
}

// loadMore is the "Load more" link of a list ([data-more-list]): ui.js
// fetches it and appends the rows; without JavaScript it opens them.
templ loadMore(href string) {
	if href != "" {
		<div class="flex justify-center" data-more-foot>
			<a class="tuc-btn is-outline is-sm" href={ templ.SafeURL(href) } data-load-more>
				@Icon("chevron-down", "size-3.5")
				{ t(ctx, "deps.load_more") }
			</a>
		</div>
	}
}

templ ignoresCard(d UpdatesData) {
	<section class={ cardClass }>
		@cardHead(t(ctx, "deps.ignores"))
		<div class={ cardBodyClass }>
			<div class="tuc-table-wrap">
				<table class="tuc-table is-compact w-full">
					<thead><tr><th>{ t(ctx, "deps.col.where") }</th><th>{ t(ctx, "deps.col.package") }</th><th>{ t(ctx, "deps.col.until") }</th><th>{ t(ctx, "deps.col.reason") }</th><th class="tuc-table__actions"></th></tr></thead>
					<tbody>
						for _, i := range d.Ignores {
							<tr>
								<td class="font-mono text-xs">{ i.Where }</td>
								<td class="font-mono text-xs">
									{ i.Package }
									if i.Advisory != "" {
										<span class="text-subtle">{ " · " + i.Advisory }</span>
									}
								</td>
								<td class="text-muted">{ i.Until }</td>
								<td>{ i.Reason }</td>
								<td class="tuc-table__actions">
									if d.CanOperate {
										<form data-confirm={ t(ctx, "confirm.unignore.title") } data-confirm-text={ t(ctx, "confirm.unignore.text") } data-confirm-ok={ t(ctx, "confirm.unignore.ok") } data-tone="warning" method="post" action="/updates/unignore">
											<input type="hidden" name="csrf" value={ d.CSRF }/>
											<input type="hidden" name="id" value={ i.ID }/>
											<button class="tuc-btn is-outline is-sm" type="submit">
												@Icon("eye", "size-3.5")
												{ t(ctx, "deps.unignore") }
											</button>
										</form>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</section>
}

// UpdatesTarget is one service's page: its findings by what to do, with
// the actions the panel can take and a copy of just this service.
templ UpdatesTarget(d UpdatesTargetData) {
	@shell(t(ctx, "deps.svc.page_title", "where", d.Label)) {
		if d.Running {
			<span hidden data-busy-poll></span>
		}
		@pageHead(d.Label, d.subtitle(ctx)) {
			<a class="tuc-btn is-ghost is-sm" href="/updates">
				@Icon("arrow-left", "size-3.5")
				{ t(ctx, "deps.svc.back") }
			</a>
			if d.ServiceHref != "" {
				<a class="tuc-btn is-ghost is-sm" href={ templ.SafeURL(d.ServiceHref) }>
					@Icon("external-link", "size-3.5")
					{ t(ctx, "deps.svc.open_service") }
				</a>
			}
			if !d.Empty {
				<button type="button" class="tuc-btn is-outline" data-copy-url={ d.Export } data-copied={ t(ctx, "common.copied") } data-copy-failed={ t(ctx, "deps.export.copy_failed") } title={ t(ctx, "deps.svc.copy_hint", "where", d.Label) }>
					@Icon("copy", "size-3.5")
					{ t(ctx, "deps.copy") }
				</button>
			}
		}
		@pageBody() {
			@errorAlert(d.Error)
			@toast("success", d.Flash)
			<div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-muted">
				if d.Source != "" {
					<span class="inline-flex min-w-0 items-center gap-1.5">
						if d.ServiceHref == "" {
							@Icon("server", "size-3.5")
						} else if d.Repo {
							@Icon("git-branch", "size-3.5")
						} else {
							@Icon("container", "size-3.5")
						}
						<span class="truncate font-mono">{ d.Source }</span>
					</span>
				}
				if len(d.Sev) > 0 {
					@sevBadges(d.Sev)
				}
			</div>
			if d.ScanError != "" {
				@notice("warning", "triangle-alert", t(ctx, "deps.svc.scan_error_detail", "detail", d.ScanError))
			}
			<div class="flex flex-wrap gap-3">
				for _, c := range d.Cards {
					<a class="flex flex-[1_1_180px] flex-col gap-0.5 rounded-md border border-border bg-surface px-4 py-3.5 text-fg no-underline hover:border-border-strong" href={ templ.SafeURL(d.Path + "#bucket-" + c.Bucket) }>
						<span class="text-xs text-muted">{ t(ctx, "deps.bucket." + c.Bucket) }</span>
						<span class={ "text-[22px] leading-[30px] font-semibold tabular-nums " + bucketTone(c.Bucket) }>{ fmt.Sprint(c.Count) }</span>
						<span class="text-xs text-subtle">{ t(ctx, "deps.bucket_sub." + c.Bucket) }</span>
					</a>
				}
			</div>
			if d.Empty {
				<section class={ cardClass }>
					<div class={ cardBodyClass }>
						if !d.Scanned {
							@emptyState("shield", t(ctx, "deps.svc.not_scanned"))
						} else {
							@emptyState("shield-check", t(ctx, "deps.svc.empty"))
						}
					</div>
				</section>
			}
			for _, s := range d.Sections {
				@updatesSection(d, s)
			}
			if d.IgnoredCount > 0 {
				<p class="m-0 text-xs text-muted">{ t(ctx, "deps.ignored_count", "n", d.IgnoredCount) }</p>
			}
			if d.CanAdmin {
				@sudoModal(d.CSRF, d.Path, d.SudoActive)
			}
		}
	}
}

// updatesSection is one bucket of a service: its title, one sentence, the
// rows and their dialogs (inside the list, so "Load more" brings both).
templ updatesSection(d UpdatesTargetData, s UpdatesSection) {
	<section class={ cardClass } id={ "bucket-" + s.Bucket } data-more-list>
		@cardHead(t(ctx, "deps.bucket."+s.Bucket)) {
			<span class="text-xs text-muted tabular-nums">{ t(ctx, "deps.rows", "n", s.Total) }</span>
			<button type="button" class="tuc-btn is-ghost is-sm" data-copy-url={ s.Export } data-copied={ t(ctx, "common.copied") } data-copy-failed={ t(ctx, "deps.export.copy_failed") } aria-label={ t(ctx, "deps.export.copy_section", "section", t(ctx, "deps.bucket."+s.Bucket)) } title={ t(ctx, "deps.export.copy_section", "section", t(ctx, "deps.bucket."+s.Bucket)) }>
				@Icon("copy", "size-3.5")
				{ t(ctx, "deps.copy") }
			</button>
		}
		<div class={ cardBodyClass }>
			<p class="m-0 text-[13px] text-muted">{ t(ctx, "deps.bucket_hint." + s.Bucket) }</p>
			if s.From > 0 {
				<span class="text-xs text-muted tabular-nums">{ t(ctx, "pagination.range", "from", s.From, "to", s.From+len(s.Rows)-1, "total", s.Total) }</span>
			}
			<div class="tuc-table-wrap">
				<table class="tuc-table is-compact w-full min-w-[760px]">
					<thead>
						<tr>
							<th>{ t(ctx, "deps.col.severity") }</th>
							<th>{ t(ctx, "deps.col.package") }</th>
							<th>{ t(ctx, "deps.col.version") }</th>
							<th>{ t(ctx, "deps.col.flaws") }</th>
							<th class="tuc-table__actions"></th>
						</tr>
					</thead>
					<tbody data-more-items>
						for _, r := range s.Rows {
							@groupRow(d.UpdatesActions, r)
						}
					</tbody>
				</table>
			</div>
			<div class="contents" data-more-items>
				for _, r := range s.Rows {
					@advisoriesDialog(r)
					if d.CanOperate {
						@ignoreDialog(d.CSRF, r, d.Path, s.Bucket)
					}
				}
			</div>
			@loadMore(s.NextHref)
		</div>
	</section>
}

templ groupRow(a UpdatesActions, r GroupRow) {
	<tr>
		<td>
			if r.Kind != "" {
				<span class={ kindBadge(r.Kind) }>{ t(ctx, "deps.kind_short." + r.Kind) }</span>
			} else {
				<span class={ sevBadge(r.Severity) }>{ t(ctx, "deps.sev." + r.Severity) }</span>
			}
		</td>
		<td class="max-w-[320px]">
			<div class="flex min-w-0 flex-col">
				<span class="truncate font-mono text-xs" title={ r.Packages }>{ r.Packages }</span>
				<span class="text-xs text-subtle">{ r.Ecosystem }</span>
			</div>
		</td>
		<td class="font-mono text-xs whitespace-nowrap">
			if r.Current == "" && r.Fixed == "" {
				<span class="text-muted">—</span>
			} else {
				<span class="text-muted">{ r.Current }</span>
				<span class="text-muted">{ " → " }</span>
				if r.Fixed != "" {
					<span class="text-success">{ r.Fixed }</span>
				} else {
					<span class="text-muted">—</span>
				}
			}
		</td>
		<td class="whitespace-nowrap">
			if r.Count > 0 {
				<button type="button" class="tuc-btn is-link is-sm px-0 text-[13px]" data-tuc-modal={ "#flaws-" + r.ID }>{ t(ctx, "deps.flaws", "n", r.Count) }</button>
			} else {
				<span class="text-xs text-muted">—</span>
			}
		</td>
		<td class="tuc-table__actions">
			<span class="inline-flex items-center justify-end gap-1.5">
				@rowAction(a, r)
				if a.CanOperate {
					<button type="button" class="tuc-btn is-ghost is-sm" data-tuc-modal={ "#ignore-" + r.ID }>
						@Icon("eye-off", "size-3.5")
						{ t(ctx, "deps.ignore.button") }
					</button>
				}
			</span>
		</td>
	</tr>
}

// rowAction is the one button the panel can do for the row, or what to do
// by hand, or why it waits.
templ rowAction(a UpdatesActions, r GroupRow) {
	switch r.Action {
		case ActDeploy:
			if a.CanOperate {
				<form class="inline-flex" method="post" action={ templ.SafeURL("/p/" + r.Project + "/s/" + r.Service + "/deploy") }>
					<input type="hidden" name="csrf" value={ a.CSRF }/>
					<button class="tuc-btn is-primary is-sm" type="submit">
						@Icon("rocket", "size-3.5")
						{ t(ctx, "deps.do.deploy") }
					</button>
				</form>
			}
		case ActHangar:
			if a.CanUpdate {
				<a class="tuc-btn is-primary is-sm" href="/update">
					@Icon("download", "size-3.5")
					{ t(ctx, "deps.do.hangar") }
				</a>
			} else {
				<span class="text-xs text-muted">{ t(ctx, "deps.do.hangar_owner") }</span>
			}
		case ActTag:
			if a.CanAdmin && a.SudoActive {
				<form class="inline-flex" data-confirm={ t(ctx, "confirm.image.title", "name", r.Where) } data-confirm-text={ t(ctx, "confirm.image.text") } data-confirm-ok={ t(ctx, "confirm.image.ok") } data-tone="warning" method="post" action={ templ.SafeURL("/p/" + r.Project + "/s/" + r.Service + "/image") }>
					<input type="hidden" name="csrf" value={ a.CSRF }/>
					<input type="hidden" name="tag" value={ r.Tag }/>
					<button class="tuc-btn is-primary is-sm" type="submit">
						@Icon("circle-arrow-up", "size-3.5")
						{ t(ctx, "deps.do.tag", "tag", r.Tag) }
					</button>
				</form>
			} else if a.CanAdmin {
				<button type="button" class="tuc-btn is-primary is-sm" data-tuc-modal="#sudo-dialog">
					@Icon("circle-arrow-up", "size-3.5")
					{ t(ctx, "deps.do.tag", "tag", r.Tag) }
				</button>
			} else {
				<span class="text-xs text-muted">{ t(ctx, "deps.do.tag_admin", "tag", r.Tag) }</span>
			}
		case ActCommand, ActAdvice:
			<span class="inline-flex w-[340px] max-w-full flex-col items-start gap-1 whitespace-normal text-left align-middle">
				if r.Text != "" {
					<span class="text-xs text-muted">{ r.Text }</span>
				}
				if r.Code != "" {
					<span class="flex max-w-full items-center gap-1">
						<code class="min-w-0 truncate rounded-xs bg-surface-2 px-1.5 py-0.5 font-mono text-xs" title={ r.Code }>{ r.Code }</code>
						<button type="button" class="tuc-btn is-ghost is-icon is-sm" data-copy={ r.Code } data-copied={ t(ctx, "common.copied") } aria-label={ t(ctx, "deps.copy") }>
							@Icon("copy", "size-3.5")
						</button>
					</span>
				}
			</span>
		case ActBadge:
			<span class="tuc-badge">{ r.Text }</span>
	}
}

func kindBadge(kind string) string {
	if kind == "major" {
		return "tuc-badge"
	}
	return "tuc-badge is-info"
}

// advisoriesDialog lists the row's advisories with their links.
templ advisoriesDialog(r GroupRow) {
	if r.Count > 0 {
		<dialog class="tuc-modal is-lg" id={ "flaws-" + r.ID } aria-labelledby={ "flaws-title-" + r.ID }>
			<div class="tuc-modal__panel">
				<div class="tuc-modal__header">
					<h2 class="tuc-modal__title" id={ "flaws-title-" + r.ID }>{ t(ctx, "deps.flaws_title", "n", r.Count, "where", r.Where) }</h2>
					<button type="button" class="tuc-btn is-ghost is-icon is-sm tuc-modal__close" data-tuc-modal-close aria-label={ t(ctx, "tucano.close") }>
						@Icon("x", "size-4")
					</button>
				</div>
				<div class="tuc-modal__body">
					<div class="tuc-table-wrap max-h-[60vh] overflow-y-auto">
						<table class="tuc-table is-compact w-full">
							<thead>
								<tr>
									<th>{ t(ctx, "deps.col.advisory") }</th>
									<th>{ t(ctx, "deps.col.package") }</th>
									<th>{ t(ctx, "deps.col.version") }</th>
								</tr>
							</thead>
							<tbody>
								for _, a := range r.Advisories {
									<tr>
										<td class="max-w-[360px]">
											<div class="flex flex-col gap-0.5">
												<span class="inline-flex flex-wrap items-center gap-1.5">
													<a class="inline-flex items-center gap-1 font-mono text-xs" href={ templ.SafeURL(a.URL) } target="_blank" rel="noopener noreferrer">
														{ a.ID }
														@Icon("external-link", "size-3")
													</a>
													<span class={ sevBadge(a.Severity) }>{ t(ctx, "deps.sev." + a.Severity) }</span>
												</span>
												if a.Aliases != "" {
													<span class="font-mono text-[11px] text-subtle">{ a.Aliases }</span>
												}
												if a.Summary != "" {
													<span class="text-xs text-muted">{ a.Summary }</span>
												}
											</div>
										</td>
										<td class="font-mono text-xs">{ a.Package }</td>
										<td class="font-mono text-xs whitespace-nowrap">
											<span class="text-muted">{ a.Current + " → " }</span>
											if a.Fixed != "" {
												<span class="text-success">{ a.Fixed }</span>
											} else {
												<span class="text-muted">—</span>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</dialog>
	}
}

// ignoreDialog asks why and for how long a row is ignored. The form
// carries the service's page and the section so the redirect comes back
// to them.
templ ignoreDialog(csrf string, r GroupRow, back, bucket string) {
	<dialog class="tuc-modal is-md is-warning" id={ "ignore-" + r.ID } aria-labelledby={ "ignore-title-" + r.ID }>
		<div class="tuc-modal__panel">
			<div class="tuc-modal__header">
				<h2 class="tuc-modal__title" id={ "ignore-title-" + r.ID }>{ t(ctx, "deps.ignore.title", "package", r.Packages) }</h2>
				<button type="button" class="tuc-btn is-ghost is-icon is-sm tuc-modal__close" data-tuc-modal-close aria-label={ t(ctx, "tucano.close") }>
					@Icon("x", "size-4")
				</button>
			</div>
			<form method="post" action="/updates/ignore" class="tuc-modal__body flex flex-col gap-4">
				<input type="hidden" name="csrf" value={ csrf }/>
				for _, id := range r.IDs {
					<input type="hidden" name="id" value={ id }/>
				}
				<input type="hidden" name="back" value={ back }/>
				<input type="hidden" name="bucket" value={ bucket }/>
				<p class="tuc-modal__text">{ t(ctx, "deps.ignore.text") }</p>
				<fieldset class="flex flex-col gap-2 border-0 p-0">
					<legend class="tuc-label mb-1.5">{ t(ctx, "deps.ignore.mode") }</legend>
					<label class="tuc-choice">
						<input class="tuc-check" type="radio" name="mode" value="days" checked?={ r.IgnoreVersion == "" }/>
						{ t(ctx, "deps.ignore.days") }
					</label>
					if r.IgnoreVersion != "" {
						<label class="tuc-choice">
							<input class="tuc-check" type="radio" name="mode" value="version" checked/>
							{ t(ctx, "deps.ignore.version", "version", r.IgnoreVersion) }
						</label>
					}
				</fieldset>
				<div class="flex min-w-0 flex-col gap-1.5">
					<label class="tuc-label" for={ "reason-" + r.ID }>{ t(ctx, "deps.col.reason") }</label>
					<input class="tuc-input" id={ "reason-" + r.ID } name="reason" required minlength="3" maxlength="300" placeholder={ t(ctx, "deps.ignore.reason_placeholder") }/>
				</div>
				<div class="flex justify-end gap-2">
					<button type="button" class="tuc-btn is-ghost" data-tuc-modal-close>{ t(ctx, "tucano.cancel") }</button>
					<button class="tuc-btn is-primary" type="submit">
						@Icon("eye-off", "size-3.5")
						{ t(ctx, "deps.ignore.button") }
					</button>
				</div>
			</form>
		</div>
	</dialog>
}

// serviceVulnsCard is the service's vulnerabilities on its Visão tab: the
// counts, its page and its copy button.
templ serviceVulnsCard(v *ServiceVulns) {
	if v != nil {
		<section class={ cardClass } id="svc-vulns">
			@cardHead(t(ctx, "deps.svc.card_title")) {
				if v.Total > 0 {
					<button type="button" class="tuc-btn is-ghost is-sm" data-copy-url={ v.Export } data-copied={ t(ctx, "common.copied") } data-copy-failed={ t(ctx, "deps.export.copy_failed") } title={ t(ctx, "deps.svc.copy_hint_here") }>
						@Icon("copy", "size-3.5")
						{ t(ctx, "deps.copy") }
					</button>
				}
				<a class="tuc-btn is-ghost is-sm" href={ templ.SafeURL(v.Href) }>
					{ t(ctx, "deps.svc.details") }
					@Icon("chevron-right", "size-3.5")
				</a>
			}
			<div class={ cardBodyClass }>
				if v.Total == 0 {
					<p class="m-0 inline-flex items-center gap-1.5 text-[13px] text-muted">
						if v.Scanned {
							@Icon("shield-check", "size-4 text-success")
							{ t(ctx, "deps.svc.nothing", "when", v.LastScan) }
						} else {
							@Icon("shield", "size-4")
							{ t(ctx, "deps.svc.not_scanned") }
						}
					</p>
				} else {
					<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
						@sevBadges(v.Sev)
						@actionBadges(v.Actions)
						<span class="grow"></span>
						if v.LastScan != "" {
							<span class="text-xs text-muted">{ t(ctx, "deps.svc.scanned", "when", v.LastScan) }</span>
						}
					</div>
				}
			</div>
		</section>
	}
}

func (d UpdatesData) subtitle(ctx context.Context) string {
	if d.LastRun == "" {
		return t(ctx, "deps.never")
	}
	if d.LastError {
		return t(ctx, "deps.last_run_partial", "when", d.LastRun)
	}
	return t(ctx, "deps.last_run", "when", d.LastRun)
}

func (d UpdatesTargetData) subtitle(ctx context.Context) string {
	if d.LastScan == "" {
		return t(ctx, "deps.never")
	}
	return t(ctx, "deps.last_run", "when", d.LastScan)
}
