package views

import (
	"fmt"
	"strings"
	"time"
)

// restartCommand opens a new setup window (a command, not prose).
const restartCommand = "sudo systemctl restart hangard"

templ layout(title string) {
	<!DOCTYPE html>
	<html
		lang={ lang(ctx) }
		{ themeAttrs(ctx)... }
		data-tuc-show={ t(ctx, "tucano.show") }
		data-tuc-hide={ t(ctx, "tucano.hide") }
		data-tuc-invalid={ t(ctx, "tucano.invalid") }
		data-tuc-close={ t(ctx, "tucano.close") }
		data-tuc-confirm={ t(ctx, "tucano.confirm") }
		data-tuc-cancel={ t(ctx, "tucano.cancel") }
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="referrer" content="no-referrer"/>
			<meta name="color-scheme" content="dark light"/>
			<title>{ title }</title>
			<link rel="icon" type="image/svg+xml" href={ asset("favicon.svg") }/>
			<link rel="stylesheet" href={ asset("app.css") }/>
			<script src={ asset("vt.js") }></script>
			<script src={ asset("vendor/tucano/tucano.min.js") } defer></script>
			<script src={ asset("tucano-texts.js") } defer></script>
			<script src={ asset("ui.js") } defer></script>
			<script src={ asset("palette.js") } defer></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

templ brand(step string) {
	<div class="flex items-center gap-2.5">
		<svg class="size-7 shrink-0 text-accent" viewBox="24 24 208 208" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M80 24H176A56 56 0 0 1 232 80V176A56 56 0 0 1 176 232H80A56 56 0 0 1 24 176V80A56 56 0 0 1 80 24ZM84 232V150A44 44 0 0 1 172 150V232Z"></path><path d="M110 196H146V232H110Z"></path></svg>
		<span class="text-base font-semibold tracking-tight">Hangar</span>
		if step != "" {
			<span class="ml-auto text-xs text-subtle">{ step }</span>
		}
	</div>
}

// toast shows a Tucano toast at the bottom center once the page loads; the
// markup is the fallback text until then.
templ toast(kind, msg string) {
	if msg != "" {
		<div class="toast-src" data-tuc-toast data-type={ kind } data-position="bottom-center" role="status">{ msg }</div>
	}
}

templ errorAlert(msg string) {
	if msg != "" {
		<div class="tuc-alert is-danger" role="alert">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v5M12 16v.01"></path></svg>
			<div class="tuc-alert__body"><p>{ msg }</p></div>
		</div>
	}
}

// languageSwitch lets visitors pick a language before logging in.
templ languageSwitch() {
	<nav class="flex justify-center gap-3 text-xs text-subtle [&_[aria-current]]:font-medium [&_[aria-current]]:text-fg" aria-label={ t(ctx, "common.language") }>
		for _, l := range Locales() {
			if l == lang(ctx) {
				<span aria-current="true">{ t(ctx, "locale." + l) }</span>
			} else {
				<a href={ templ.SafeURL("/login?lang=" + l) } hreflang={ l }>{ t(ctx, "locale." + l) }</a>
			}
		}
	</nav>
}

// Login is the first step: e-mail and password.
templ Login(email, errMsg, notice string) {
	@layout(t(ctx, "login.page_title")) {
		<main class="dots flex min-h-screen items-center justify-center px-4 py-6">
			<form class="flex w-full max-w-[380px] flex-col gap-[18px] rounded-md border border-border bg-surface p-7" method="post" action="/login" autocomplete="on">
				<input type="hidden" name="csrf" value={ loginCSRF(ctx) }/>
				@brand("")
				<div>
					<h1 class="m-0 text-xl font-semibold">{ t(ctx, "login.title") }</h1>
					<p class="mt-1 text-[13px] text-muted">{ t(ctx, "login.subtitle") }</p>
				</div>
				@errorAlert(errMsg)
				if notice != "" {
					<div class="tuc-alert is-danger" role="status">
						@Icon("lock", "size-4")
						<div class="tuc-alert__body"><p>{ notice }</p></div>
					</div>
				}
				<div class="flex min-w-0 flex-col gap-1.5">
					<label class="tuc-label" for="email">{ t(ctx, "login.email") }</label>
					<input class="tuc-input" id="email" name="email" type="email" autocomplete="username" required value={ email } autofocus?={ email == "" }/>
				</div>
				<div class="flex min-w-0 flex-col gap-1.5">
					<label class="tuc-label" for="password">{ t(ctx, "login.password") }</label>
					<input class="tuc-input" id="password" name="password" type="password" autocomplete="current-password" required autofocus?={ email != "" } data-tuc-reveal/>
				</div>
				<button class="tuc-btn is-primary is-block" type="submit">
					@Icon("arrow-right", "size-4")
					{ t(ctx, "login.continue") }
				</button>
				<p class="tuc-hint">{ t(ctx, "login.no_reset") }</p>
				@languageSwitch()
			</form>
		</main>
	}
}

// TwoFactor is the second step: authenticator or recovery code.
templ TwoFactor(errMsg string) {
	@layout(t(ctx, "twofa.page_title")) {
		<main class="dots flex min-h-screen items-center justify-center px-4 py-6">
			<form class="flex w-full max-w-[380px] flex-col gap-[18px] rounded-md border border-border bg-surface p-7" method="post" action="/login/2fa" autocomplete="off">
				@brand(t(ctx, "login.step", "n", 2, "total", 2))
				<div>
					<h1 class="m-0 text-xl font-semibold">{ t(ctx, "twofa.title") }</h1>
					<p class="mt-1 text-[13px] text-muted">{ t(ctx, "twofa.subtitle") }</p>
				</div>
				@errorAlert(errMsg)
				<div class="flex min-w-0 flex-col gap-1.5">
					<label class="tuc-label" for="code">{ t(ctx, "twofa.code") }</label>
					<input class="tuc-input input-code" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="17" required autofocus/>
				</div>
				<button class="tuc-btn is-primary is-block" type="submit">
					@Icon("check", "size-4")
					{ t(ctx, "twofa.submit") }
				</button>
				<div class="flex justify-between text-[13px]">
					<span class="text-muted">{ t(ctx, "twofa.lost_phone") }</span>
				</div>
				<div class="tuc-alert is-info">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3 4 6v6c0 4.5 3.4 8.3 8 9 4.6-.7 8-4.5 8-9V6l-8-3Z"></path></svg>
					<div class="tuc-alert__body"><p>{ t(ctx, "twofa.limit_note") }</p></div>
				</div>
			</form>
		</main>
	}
}

// Sudo is the re-confirmation page: it is shown when a fresh confirmation
// fails, keeping the error and the next destination so the person can try
// again on a styled page instead of a bare error. The field is the account
// password when there is no 2FA, otherwise the authenticator code.
templ Sudo(errMsg, next, csrf string) {
	@layout(t(ctx, "sudo.title")) {
		<main class="dots flex min-h-screen items-center justify-center px-4 py-6">
			<form class="flex w-full max-w-[380px] flex-col gap-[18px] rounded-md border border-border bg-surface p-7" method="post" action="/sudo" autocomplete="off">
				<input type="hidden" name="csrf" value={ csrf }/>
				<input type="hidden" name="next" value={ next }/>
				@brand("")
				<div>
					<h1 class="m-0 text-xl font-semibold">{ t(ctx, "sudo.title") }</h1>
					<p class="mt-1 text-[13px] text-muted">{ t(ctx, "sudo.text") }</p>
				</div>
				@errorAlert(errMsg)
				if noTOTP(ctx) {
					<div class="flex min-w-0 flex-col gap-1.5">
						<label class="tuc-label" for="code">{ t(ctx, "sudo.password_label") }</label>
						<input class="tuc-input" id="code" name="code" type="password" autocomplete="current-password" required autofocus data-tuc-reveal/>
					</div>
				} else {
					<div class="flex min-w-0 flex-col gap-1.5">
						<label class="tuc-label" for="code">{ t(ctx, "twofa.code") }</label>
						<input class="tuc-input input-code" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="17" required autofocus/>
					</div>
				}
				<button class="tuc-btn is-primary is-block" type="submit">
					@Icon("shield-check", "size-4")
					{ t(ctx, "sudo.confirm") }
				</button>
			</form>
		</main>
	}
}

// SetupForm is what the first-run setup page shows and keeps between tries.
type SetupForm struct {
	Email       string
	TwoFA       bool
	Required    bool // the server demands 2FA (require_2fa)
	MinLen      int
	MinutesLeft int // until the setup window closes
}

// Setup is the first-run page: the owner account, created from the browser
// while the setup window is open.
templ Setup(f SetupForm, errMsg string) {
	@layout(t(ctx, "setup.page_title")) {
		<main class="dots flex min-h-screen items-center justify-center px-4 py-6">
			<form class="flex w-full max-w-[420px] flex-col gap-[18px] rounded-md border border-border bg-surface p-7" method="post" action="/setup" autocomplete="on">
				<input type="hidden" name="csrf" value={ loginCSRF(ctx) }/>
				@brand(t(ctx, "setup.closes_in", "min", f.MinutesLeft))
				<div>
					<h1 class="m-0 text-xl font-semibold">{ t(ctx, "setup.title") }</h1>
					<p class="mt-1 text-[13px] text-muted">{ t(ctx, "setup.subtitle") }</p>
				</div>
				@errorAlert(errMsg)
				<div class="flex min-w-0 flex-col gap-1.5">
					<label class="tuc-label" for="email">{ t(ctx, "setup.email") }</label>
					<input class="tuc-input" id="email" name="email" type="email" autocomplete="username" maxlength="254" required value={ f.Email } autofocus/>
				</div>
				<div class="flex min-w-0 flex-col gap-1.5">
					<label class="tuc-label" for="password">{ t(ctx, "setup.password") }</label>
					<input class="tuc-input" id="password" name="password" type="password" autocomplete="new-password" minlength={ f.MinLen } maxlength="256" required data-tuc-reveal/>
					<span class="tuc-hint">{ t(ctx, "setup.password_hint", "min", f.MinLen) }</span>
				</div>
				<div class="flex min-w-0 flex-col gap-1.5">
					<label class="tuc-label" for="confirm">{ t(ctx, "setup.confirm") }</label>
					<input class="tuc-input" id="confirm" name="confirm" type="password" autocomplete="new-password" minlength={ f.MinLen } maxlength="256" required data-tuc-reveal/>
				</div>
				if f.Required {
					<div class="tuc-alert is-info" role="note">
						@Icon("shield-check", "size-4")
						<div class="tuc-alert__body"><p>{ t(ctx, "setup.twofa_required") }</p></div>
					</div>
				} else {
					<div class="flex flex-col gap-1">
						<label class="tuc-choice">
							<input type="checkbox" class="tuc-check" name="twofa" value="1" checked?={ f.TwoFA }/>
							<span>{ t(ctx, "setup.twofa") }</span>
						</label>
						<p class="tuc-hint">{ t(ctx, "setup.twofa_hint") }</p>
					</div>
				}
				<button class="tuc-btn is-primary is-block" type="submit">
					@Icon("arrow-right", "size-4")
					{ t(ctx, "setup.submit") }
				</button>
				@setupLanguageSwitch()
			</form>
		</main>
	}
}

// SetupExpired tells a visitor the setup window closed with no account
// created, and how the operator opens a new one.
templ SetupExpired(window time.Duration) {
	@layout(t(ctx, "setup.page_title")) {
		<main class="dots flex min-h-screen items-center justify-center px-4 py-6">
			<div class="flex w-full max-w-[420px] flex-col gap-[18px] rounded-md border border-border bg-surface p-7">
				@brand("")
				<div>
					<h1 class="m-0 text-xl font-semibold">{ t(ctx, "setup.expired_title") }</h1>
					<p class="mt-1 text-[13px] text-muted">{ t(ctx, "setup.expired_text", "min", int(window.Minutes())) }</p>
				</div>
				<pre class="m-0 overflow-x-auto rounded-sm border border-border bg-bg px-3 py-2 font-mono text-[13px]">{ restartCommand }</pre>
			</div>
		</main>
	}
}

// setupLanguageSwitch is the language picker of the setup page.
templ setupLanguageSwitch() {
	<nav class="flex justify-center gap-3 text-xs text-subtle [&_[aria-current]]:font-medium [&_[aria-current]]:text-fg" aria-label={ t(ctx, "common.language") }>
		for _, l := range Locales() {
			if l == lang(ctx) {
				<span aria-current="true">{ t(ctx, "locale." + l) }</span>
			} else {
				<a href={ templ.SafeURL("/setup?lang=" + l) } hreflang={ l }>{ t(ctx, "locale." + l) }</a>
			}
		}
	</nav>
}

// errorKey picks the texts of an error page by status.
func errorKey(status int) string {
	switch {
	case status == 404 || status == 405:
		return "not_found"
	case status == 403:
		return "forbidden"
	case status == 429:
		return "too_many"
	case status >= 500:
		return "server"
	}
	return "other"
}

// errorDetail keeps the server's own message when it says something more
// than the status (Go's "404 page not found" adds nothing).
func errorDetail(status int, msg string) string {
	if status == 404 || status == 405 || msg == "" || strings.HasPrefix(msg, fmt.Sprint(status)) {
		return ""
	}
	return msg
}

// ErrorPage is what a browser sees for a panel error: the status, a plain
// explanation and a way back.
templ ErrorPage(status int, msg string) {
	@layout(t(ctx, "errorpage." + errorKey(status) + ".title") + " · Hangar") {
		<main class="dots flex min-h-screen items-center justify-center px-4 py-6">
			<div class="flex w-full max-w-[420px] flex-col gap-[18px] rounded-md border border-border bg-surface p-7">
				@brand(fmt.Sprint(status))
				<div>
					<h1 class="m-0 text-xl font-semibold">{ t(ctx, "errorpage." + errorKey(status) + ".title") }</h1>
					<p class="mt-1 text-[13px] text-muted">{ t(ctx, "errorpage." + errorKey(status) + ".text") }</p>
				</div>
				if d := errorDetail(status, msg); d != "" {
					<div class="tuc-alert is-danger" role="alert">
						@Icon("circle-alert", "size-4")
						<div class="tuc-alert__body"><p>{ d }</p></div>
					</div>
				}
				<a class="tuc-btn is-primary is-block" href="/">
					@Icon("arrow-left", "size-4")
					{ t(ctx, "errorpage.home") }
				</a>
			</div>
		</main>
	}
}
