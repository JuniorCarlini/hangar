package views

// Connecting services: the dialog that shows what one service offers and
// which variable of the other receives each value (a bridge between two
// names: the app's DB_HOST gets the database's HOST). canvas.js opens it
// after a drag between cards; the Variables tab, from "Connector".

// ConnectRow is one offered value and the variable that would receive it.
type ConnectRow struct {
	Key     string
	Secret  bool
	Var     string
	Known   bool // the app already uses (or documents) this name
	Current bool // the variable exists with another value: connecting replaces it
	Linked  bool // already connected to this very value
	Checked bool
}

// ConnectGroup is one service that offers values, with its rows.
type ConnectGroup struct {
	Target string
	Rows   []ConnectRow
}

// ConnectFormData feeds the body of the connect dialog: one group per
// service that offers something (only the dragged one from the canvas).
type ConnectFormData struct {
	CSRF    string
	Project string
	From    string
	Groups  []ConnectGroup
	Vars    []string // the app's variables, to pick one by hand
	Error   string
	// CanSecrets: admins connect secret values; below admin a secret row
	// is shown but cannot be ticked (the server refuses it, SEC-015).
	CanSecrets bool
}

// connectField names a row's fields: "db|HOST" ticks it and
// "var_db|HOST" is the variable that receives it.
func connectField(target, key string) string { return target + "|" + key }

// ConnectForm is the dialog's body, loaded on demand: every service that
// offers something, in order, in one scrolling list.
templ ConnectForm(d ConnectFormData) {
	if d.Error != "" {
		@notice("warning", "circle-alert", d.Error)
	} else {
		<form method="post" action={ templ.SafeURL("/p/" + d.Project + "/s/" + d.From + "/connect") } class="flex flex-col gap-3">
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			<p class="m-0 text-[13px] text-muted">{ t(ctx, "connect.intro", "from", d.From) }</p>
			<div class="tuc-table-wrap max-h-[55vh] overflow-y-auto rounded-sm border border-border">
				<table class="tuc-table is-compact connect-table w-full">
					<thead class="sticky top-0 z-[1] bg-surface">
						<tr>
							<th class="w-8"><span class="sr-only">{ t(ctx, "connect.use") }</span></th>
							<th>{ t(ctx, "connect.offered_col") }</th>
							<th class="w-6"></th>
							<th>{ t(ctx, "connect.receives", "service", d.From) }</th>
						</tr>
					</thead>
					for _, g := range d.Groups {
						<tbody>
							<tr>
								<th colspan="4" class="bg-surface-2 text-[13px] font-semibold">
									<span class="inline-flex items-center gap-2">
										@Icon("cable", "size-3.5 text-accent-text")
										{ g.Target }
									</span>
								</th>
							</tr>
							for _, r := range g.Rows {
								<tr>
									<td>
										if r.Secret && !d.CanSecrets {
											<input type="checkbox" class="tuc-check" disabled title={ t(ctx, "connect.secret_admin") } aria-label={ t(ctx, "connect.secret_admin") }/>
										} else {
											<input type="checkbox" class="tuc-check" name="key" value={ connectField(g.Target, r.Key) } checked?={ r.Checked } aria-label={ t(ctx, "connect.use_named", "key", g.Target+" · "+r.Key) }/>
										}
									</td>
									<td class="font-mono text-[13px] whitespace-nowrap">
										<span class="inline-flex items-center gap-1.5">
											{ r.Key }
											if r.Secret {
												<span title={ t(ctx, "connect.secret") }>
													@Icon("lock", "size-3 text-subtle")
												</span>
											}
										</span>
									</td>
									<td class="text-subtle">
										@Icon("arrow-right", "size-3.5")
									</td>
									<td>
										<div class="flex min-w-0 flex-col gap-1">
											<input class="tuc-input font-mono text-[13px]" name={ "var_" + connectField(g.Target, r.Key) } value={ r.Var } list="connect-vars" required pattern="[A-Za-z_][A-Za-z0-9_]{0,127}" aria-label={ t(ctx, "connect.var_for", "key", g.Target+" · "+r.Key) }/>
											if r.Linked {
												<span class="text-xs text-success">{ t(ctx, "connect.linked") }</span>
											} else if r.Current {
												<span class="text-xs text-warning">{ t(ctx, "connect.replaces") }</span>
											} else if r.Known {
												<span class="text-xs text-muted">{ t(ctx, "connect.known") }</span>
											}
										</div>
									</td>
								</tr>
							}
						</tbody>
					}
				</table>
			</div>
			<datalist id="connect-vars">
				for _, v := range d.Vars {
					<option value={ v }></option>
				}
			</datalist>
			<p class="tuc-hint">{ t(ctx, "connect.hint", "from", d.From) }</p>
			<div class="flex justify-end gap-2">
				<button type="button" class="tuc-btn is-ghost" data-tuc-modal-close>{ t(ctx, "tucano.cancel") }</button>
				<button class="tuc-btn is-primary" type="submit">
					@Icon("link", "size-3.5")
					{ t(ctx, "connect.save") }
				</button>
			</div>
		</form>
	}
}

// connectModal is the shell canvas.js fills with the form.
templ connectModal(project string) {
	<dialog
		class="tuc-modal is-lg"
		id="connect-modal"
		aria-labelledby="connect-modal-title"
		data-project={ project }
		data-title={ t(ctx, "connect.title") }
		data-loading={ t(ctx, "connect.loading") }
		data-failed={ t(ctx, "connect.failed") }
	>
		<div class="tuc-modal__panel">
			<div class="tuc-modal__header">
				<h2 class="tuc-modal__title" id="connect-modal-title"></h2>
				<button type="button" class="tuc-btn is-ghost is-icon is-sm tuc-modal__close" data-tuc-modal-close aria-label={ t(ctx, "tucano.close") }>
					@Icon("x", "size-4")
				</button>
			</div>
			<div class="tuc-modal__body">
				<div id="connect-body"></div>
			</div>
		</div>
	</dialog>
}
