package views

import "context"

// DomainsData is the global dynamic domains page.
type DomainsData struct {
	CSRF        string
	EdgeEnabled bool
	Dynamic     string // "project/service" taking customer domains, or ""
	DynamicURL  string
	Recent      []AskRow
	Page        Cursor // older and newer pages of Recent
	Blocked     []BlockedRow
	Filter      string
	Certified   int64
	NewThisHour int64
	HourCap     int
	DeniedToday int64
	// EntryHost is the address customers point their domains at, and
	// EntryPath how it reaches this server (direct, cloudflare, elsewhere;
	// "" when it was not checked).
	EntryHost string
	EntryPath string
	MinCap    int
	MaxCap    int
	CanAdmin  bool
	Error     string
	Flash     string
}

// AskRow is one aggregated certificate decision.
type AskRow struct {
	Hostname string
	Allowed  bool
	Reason   string
	Count    int64
	When     string
	Blocked  bool
	Via      string // direct, cloudflare, elsewhere or "" (fixed domains)
}

// BlockedRow is a blocked hostname.
type BlockedRow struct {
	Hostname string
	Reason   string
	When     string
}

// stat is a number card (label, value, note), as in the prototype.
templ stat(label, value, sub, tone string) {
	<div class="flex flex-[1_1_180px] flex-col gap-0.5 rounded-md border border-border bg-surface px-4 py-3.5">
		<span class="text-xs text-muted">{ label }</span>
		<span class={ "text-[22px] leading-[30px] font-semibold tabular-nums " + tone }>{ value }</span>
		<span class="text-xs text-subtle">{ sub }</span>
	</div>
}

func capText(n int64, cap int) string {
	if cap <= 0 {
		return sz(int(n))
	}
	return sz(int(n)) + " / " + sz(cap)
}

func selectedIf(cur, v string) bool { return cur == v }

// capPercent is the hour's use of the cap, for the bar (0-100).
func capPercent(n int64, cap int) int {
	if cap <= 0 {
		return 0
	}
	return min(100, int(n*100/int64(cap)))
}

// nearCap: 80% of the hour's cap is used.
func nearCap(n int64, cap int) bool { return cap > 0 && n*5 >= int64(cap)*4 }

func pathBadge(via string) string {
	switch via {
	case "cloudflare":
		return "tuc-badge is-info"
	case "elsewhere":
		return "tuc-badge is-danger"
	}
	return "tuc-badge"
}

// entryCard is where customers point their domains, with how it reaches
// the server, and the reminder about Cloudflare's SSL mode.
templ entryCard(d DomainsData) {
	<section class={ cardClass }>
		@cardHead(t(ctx, "domains.entry.title"))
		<div class={ cardBodyClass + " flex flex-col gap-3" }>
			<div class="flex flex-wrap items-center gap-2">
				<strong class="text-[13px] font-semibold">{ t(ctx, "domains.entry.label") }</strong>
				switch d.EntryPath {
					case "direct":
						<span class="tuc-badge is-success">{ t(ctx, "domains.entry.reaches") }</span>
					case "cloudflare":
						<span class="tuc-badge is-warning">{ t(ctx, "domain.path.cloudflare") }</span>
					case "elsewhere":
						<span class="tuc-badge is-danger">{ t(ctx, "domains.entry.not_here") }</span>
				}
			</div>
			<div class="flex items-center gap-1.5">
				<code class="min-w-0 grow rounded-sm border border-border bg-surface-2 px-2 py-1.5 font-mono text-[13px] break-all select-all">{ d.EntryHost }</code>
				<button type="button" class="tuc-btn is-ghost is-icon is-sm shrink-0" data-copy={ d.EntryHost } data-copied={ t(ctx, "common.copied") } aria-label={ t(ctx, "domains.entry.copy") } title={ t(ctx, "domains.entry.copy") }>
					@Icon("copy", "size-3.5")
				</button>
			</div>
			<p class="text-[13px] text-muted">{ t(ctx, "domains.entry.explain") }</p>
			if d.EntryPath == "cloudflare" {
				<div class="tuc-alert is-warning" role="status">
					@Icon("triangle-alert", "size-4")
					<div class="tuc-alert__body"><p>{ t(ctx, "domains.entry.orange", "host", d.EntryHost) }</p></div>
				</div>
			}
			if d.EntryPath == "elsewhere" {
				<div class="tuc-alert is-warning" role="status">
					@Icon("triangle-alert", "size-4")
					<div class="tuc-alert__body"><p>{ t(ctx, "domains.entry.fix", "host", d.EntryHost) }</p></div>
				</div>
			}
			<div class="tuc-alert is-info" role="note">
				@Icon("info", "size-4")
				<div class="tuc-alert__body"><p>{ t(ctx, "domains.entry.cloudflare") }</p></div>
			</div>
		</div>
	</section>
}

// hourCapCard sets how many new domains may get a certificate per hour and
// shows this hour's use.
templ hourCapCard(d DomainsData) {
	<section class={ cardClass }>
		@cardHead(t(ctx, "domains.limit.title"))
		<div class={ cardBodyClass + " flex flex-col gap-3" }>
			<div class="flex flex-wrap items-end gap-3">
				if d.CanAdmin {
					<form method="post" action="/domains/limit" class="flex items-end gap-2">
						<input type="hidden" name="csrf" value={ d.CSRF }/>
						<div class="flex flex-col gap-1.5">
							<label class="tuc-label" for="hour-cap">{ t(ctx, "domains.limit.label") }</label>
							<input class="tuc-input w-28 tabular-nums" id="hour-cap" name="cap" type="number" required min={ sz(d.MinCap) } max={ sz(d.MaxCap) } value={ sz(d.HourCap) }/>
						</div>
						<button class="tuc-btn is-primary" type="submit">{ t(ctx, "domains.limit.save") }</button>
					</form>
				}
				<div class="flex min-w-[200px] flex-1 flex-col gap-1.5">
					<div class="flex justify-between text-xs text-muted">
						<span>{ t(ctx, "domains.limit.hour") }</span>
						<span class="tabular-nums">{ t(ctx, "domains.limit.used", "n", d.NewThisHour, "cap", d.HourCap) }</span>
					</div>
					<div class="h-1 w-full bg-surface-2" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow={ sz(capPercent(d.NewThisHour, d.HourCap)) } aria-label={ t(ctx, "domains.limit.hour") }>
						<div class={ "bar-fill h-1 " + toneBg(level(capPercent(d.NewThisHour, d.HourCap))) + " " + pctWidth(capPercent(d.NewThisHour, d.HourCap)) }></div>
					</div>
				</div>
			</div>
			<p class="text-[13px] text-muted">{ t(ctx, "domains.limit.explain") }</p>
			if nearCap(d.NewThisHour, d.HourCap) {
				<div class="tuc-alert is-warning" role="status">
					@Icon("triangle-alert", "size-4")
					<div class="tuc-alert__body"><p>{ t(ctx, "domains.limit.near", "n", d.NewThisHour, "cap", d.HourCap) }</p></div>
				</div>
			}
		</div>
	</section>
}

// Domains lists recent certificate decisions and the blocklist.
templ Domains(d DomainsData) {
	@shell(t(ctx, "domains.page_title")) {
		@pageHead(t(ctx, "domains.title"), d.subtitle(ctx)) {
			if d.Dynamic != "" {
				<a class="tuc-btn is-outline" href={ templ.SafeURL(d.DynamicURL + "?tab=domains") }>
					@Icon("settings", "size-3.5")
					{ t(ctx, "domains.configure") }
				</a>
			}
		}
		@pageBody() {
			@errorAlert(d.Error)
			@toast("success", d.Flash)
			if !d.EdgeEnabled {
				<div class="tuc-alert is-warning" role="status">
					@Icon("triangle-alert", "size-4")
					<div class="tuc-alert__body"><p>{ t(ctx, "domain.edge_disabled") }</p></div>
				</div>
			}
			if d.Dynamic == "" {
				<div class="tuc-alert is-info">
					@Icon("info", "size-4")
					<div class="tuc-alert__body"><p>{ t(ctx, "domains.no_dynamic") }</p></div>
				</div>
			}
			if d.EntryHost != "" {
				@entryCard(d)
			}
			<div class="flex flex-wrap gap-3">
				@stat(t(ctx, "domains.stat.certified"), sz(int(d.Certified)), t(ctx, "domains.stat.certified_sub"), "")
				@stat(t(ctx, "domains.stat.new"), capText(d.NewThisHour, d.HourCap), t(ctx, "domains.stat.new_sub"), "")
				@stat(t(ctx, "domains.stat.denied"), sz(int(d.DeniedToday)), t(ctx, "domains.stat.denied_sub"), "text-warning")
			</div>
			if d.EdgeEnabled {
				@hourCapCard(d)
			}
			// One card, two lists: the certificate requests (all, denied or
			// allowed) and the blocked domains, picked in the head.
			<section class={ cardClass }>
				@cardHead(t(ctx, "domains.list")) {
					<form method="get" action="/domains" class="w-44">
						<select class="tuc-input w-44" name="f" aria-label={ t(ctx, "domains.filter") } data-tuc-select data-clearable="false" data-autosubmit>
							<option value="all" selected?={ d.Filter == "" || d.Filter == "all" }>{ t(ctx, "domains.filter_all") }</option>
							<option value="deny" selected?={ selectedIf(d.Filter, "deny") }>{ t(ctx, "domains.filter_deny") }</option>
							<option value="allow" selected?={ selectedIf(d.Filter, "allow") }>{ t(ctx, "domains.filter_allow") }</option>
							<option value="blocked" selected?={ selectedIf(d.Filter, "blocked") }>{ t(ctx, "domains.blocked") }</option>
						</select>
					</form>
					if d.CanAdmin {
						<button type="button" class="tuc-btn is-outline is-sm" data-tuc-modal="#block-modal">
							@Icon("ban", "size-3.5")
							{ t(ctx, "domains.block_add") }
						</button>
					}
				}
				if d.Filter == "blocked" {
					@blockedTable(d)
				} else {
					@recentTable(d)
					@cursorPager(d.Page)
				}
			</section>
			if d.CanAdmin {
				@blockDialog(d)
			}
		}
	}
}

templ recentTable(d DomainsData) {
	if len(d.Recent) == 0 {
		@emptyState("shield-check", t(ctx, "domains.recent_empty"))
	} else {
		<div class="tuc-table-wrap">
			<table class="tuc-table is-compact w-full">
				<thead><tr><th>{ t(ctx, "domain.hostname") }</th><th>{ t(ctx, "domains.decision") }</th><th>{ t(ctx, "domains.reason") }</th><th>{ t(ctx, "domains.path") }</th><th class="is-number">{ t(ctx, "domains.count") }</th><th>{ t(ctx, "domains.last") }</th><th class="tuc-table__actions"></th></tr></thead>
				<tbody>
					for _, a := range d.Recent {
						<tr>
							<td class="font-mono">{ a.Hostname }</td>
							<td>
								if a.Allowed {
									<span class="tuc-badge is-success">{ t(ctx, "domains.allowed") }</span>
								} else {
									<span class="tuc-badge is-danger">{ t(ctx, "domains.denied") }</span>
								}
							</td>
							<td class="text-muted">{ t(ctx, "domain.reason." + a.Reason) }</td>
							<td>
								if a.Via != "" {
									<span class={ pathBadge(a.Via) }>{ t(ctx, "domain.path." + a.Via) }</span>
								}
							</td>
							<td class="is-number">{ sz(int(a.Count)) }</td>
							<td class="text-muted">{ a.When }</td>
							<td class="tuc-table__actions">
								if d.CanAdmin && !a.Blocked && a.Reason != "invalid_hostname" {
									<form data-confirm={ t(ctx, "confirm.block.title") } data-confirm-text={ t(ctx, "confirm.block.text") } data-confirm-ok={ t(ctx, "confirm.block.ok") } data-tone="warning" method="post" action="/domains/block">
										<input type="hidden" name="csrf" value={ d.CSRF }/>
										<input type="hidden" name="hostname" value={ a.Hostname }/>
										<button class="tuc-btn is-ghost is-icon is-sm" type="submit" title={ t(ctx, "domains.block_named", "host", a.Hostname) } aria-label={ t(ctx, "domains.block_named", "host", a.Hostname) }>
											@Icon("ban", "size-3.5")
										</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

templ blockedTable(d DomainsData) {
	if len(d.Blocked) == 0 {
		@emptyState("ban", t(ctx, "domains.blocked_empty"))
	} else {
		<div class="tuc-table-wrap">
			<table class="tuc-table is-compact w-full">
				<thead><tr><th>{ t(ctx, "domain.hostname") }</th><th>{ t(ctx, "domains.reason") }</th><th>{ t(ctx, "domains.since") }</th><th class="tuc-table__actions"></th></tr></thead>
				<tbody>
					for _, b := range d.Blocked {
						<tr>
							<td class="font-mono">{ b.Hostname }</td>
							<td>{ b.Reason }</td>
							<td class="text-muted">{ b.When }</td>
							<td class="tuc-table__actions">
								if d.CanAdmin {
									<form data-confirm={ t(ctx, "confirm.unblock.title") } data-confirm-text={ t(ctx, "confirm.unblock.text") } data-confirm-ok={ t(ctx, "confirm.unblock.ok") } data-tone="success" method="post" action="/domains/unblock">
										<input type="hidden" name="csrf" value={ d.CSRF }/>
										<input type="hidden" name="hostname" value={ b.Hostname }/>
										<button class="tuc-btn is-outline is-sm" type="submit" aria-label={ t(ctx, "domains.unblock_named", "host", b.Hostname) }>
											@Icon("circle-check", "size-3.5")
											{ t(ctx, "domains.unblock") }
										</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// blockDialog blocks a domain by hand: it never gets a certificate here.
templ blockDialog(d DomainsData) {
	<dialog class="tuc-modal is-md" id="block-modal" aria-labelledby="block-modal-title">
		<div class="tuc-modal__panel">
			<div class="tuc-modal__header">
				<h2 class="tuc-modal__title" id="block-modal-title">{ t(ctx, "domains.block_add") }</h2>
				<button type="button" class="tuc-btn is-ghost is-icon is-sm tuc-modal__close" data-tuc-modal-close aria-label={ t(ctx, "tucano.close") }>
					@Icon("x", "size-4")
				</button>
			</div>
			<form class="tuc-modal__body" method="post" action="/domains/block">
				<input type="hidden" name="csrf" value={ d.CSRF }/>
				<p class="tuc-modal__text">{ t(ctx, "confirm.block.text") }</p>
				<div class="flex flex-col gap-1.5">
					<label class="tuc-label" for="hostname">{ t(ctx, "domain.hostname") }</label>
					<input class="tuc-input font-mono" id="hostname" name="hostname" required maxlength="253" autocomplete="off" placeholder="golpe-banco.com" autofocus/>
				</div>
				<div class="flex flex-col gap-1.5">
					<label class="tuc-label" for="reason">{ t(ctx, "domains.reason") }</label>
					<input class="tuc-input" id="reason" name="reason" maxlength="200" placeholder={ t(ctx, "domains.reason_placeholder") }/>
				</div>
				<div class="flex justify-end gap-2">
					<button type="button" class="tuc-btn is-ghost" data-tuc-modal-close>{ t(ctx, "tucano.cancel") }</button>
					<button class="tuc-btn is-danger" type="submit">
						@Icon("ban", "size-3.5")
						{ t(ctx, "domains.block") }
					</button>
				</div>
			</form>
		</div>
	</dialog>
}

// subtitle names the service taking customer domains.
func (d DomainsData) subtitle(ctx context.Context) string {
	if d.Dynamic == "" {
		return ""
	}
	return t(ctx, "domains.subtitle", "service", d.Dynamic)
}
