package views

import (
	"context"
	"fmt"
	"slices"
)

// ServiceBackups is the service's Backups tab (docs/17 "Backups (do
// serviço)").
type ServiceBackups struct {
	Supported    bool
	Ready        bool // a destination and a key to encrypt to
	Simple       bool // the server keeps the key: no kit to restore
	HasKit       bool
	Enabled      bool
	EveryHours   int
	AtTime       string // "03:00"
	WAL          bool
	WALSupported bool
	// Volumes: the service is backed up as a copy of its volumes; Method
	// says how Hangar backs it up (svcbackup.method.*), never a choice.
	Volumes      bool
	Method       string
	// OpenRoutine opens the routine dialog with the page (?routine=1,
	// the "Create routine" link of the backups page).
	OpenRoutine bool
	NextRun      string
	WALState     string
	WALTone      string
	Window       string
	WindowOK     bool
	LastBase     string
	Download     *DownloadView
	Dumps        []DumpChoice
	DefaultNew   string
	MaxAt        string // ISO, the newest moment that can be chosen
	Runs         []BackupRunRow
	RunsPage     Cursor
	Restores     []RestoreRow
	// RestoreFailed is the newest restore when it failed: shown on top.
	RestoreFailed *RestoreRow
	Busy          bool // something running: the tab refreshes itself
}

// DownloadView is a prepared encrypted download.
type DownloadView struct {
	Token    string
	FileName string
	Size     string
	Ready    bool
	Error    string
	Expires  string
}

// DumpChoice is a logical backup that can be restored.
type DumpChoice struct {
	Key   string
	Label string
}

// RestoreRow is a restore in the history.
type RestoreRow struct {
	When   string
	What   string
	Dest   string
	Status string
	Tone   string
	Step   string
	Error  string
	From   string // the service restored from, on the copy's tab
	// Saved says which roles the restore recreated as in the original.
	Saved string
	// Roles says which roles the restore created without a password.
	Roles string
	// Cleanup says what became of the new service of a failed restore.
	Cleanup string
}

var everyHours = []int{24, 12, 6, 1}

templ tabBackups(d ServiceData) {
	if !d.Backups.Supported {
		<section class={ cardClass }>
			@emptyState("database-backup", t(ctx, "svcbackup.unsupported"))
		</section>
	} else {
		if d.Backups.Busy {
			// ui.js reloads once the backup is over (data-busy-poll).
			<span hidden data-busy-poll></span>
		}
		if r := d.Backups.RestoreFailed; r != nil {
			<div class="tuc-alert is-danger" role="alert">
				@Icon("circle-x", "size-4")
				<div class="tuc-alert__body flex min-w-0 flex-col gap-1">
					<p class="font-semibold">{ t(ctx, "svcbackup.restore_failed", "when", r.When, "service", r.Dest) }</p>
					if r.Error != "" {
						<p class="font-mono text-xs break-words">{ r.Error }</p>
					}
					if r.Cleanup != "" {
						<p class="text-xs">{ r.Cleanup }</p>
					}
				</div>
			</div>
		}
		if d.Backups.WAL {
			@svcBackupWAL(d)
		}
		if !d.Backups.Ready {
			// Nothing works before a destination (and, with the kit, a
			// confirmed key) exists: say where to set it up.
			<section class={ cardClass }>
				@emptyState("database-backup", notReadyText(ctx, d.Backups.Simple, "svcbackup")) {
					if d.CanAdmin {
						<a class="tuc-btn is-outline is-sm" href="/backups?tab=config">
							@Icon("settings", "size-3.5")
							{ t(ctx, "svcbackup.open_backups") }
						</a>
					}
				}
			</section>
		} else {
			@svcBackupRoutines(d)
		}
		// What was backed up and restored, with "back up now" and
		// "restore" on top.
		<section class={ cardClass }>
			@cardHead(t(ctx, "svcbackup.title")) {
				@svcBackupActions(d)
			}
			// A download made first and fetched once (encrypted with the
			// kit; a copy of volumes in every mode).
			if d.CanAdmin && d.Backups.Download != nil {
				<div class="flex flex-wrap items-center justify-end gap-3 border-b border-border px-4 py-3">
					@svcDownloadState(*d.Backups.Download, d.SudoCritical, d.Backups.Volumes)
				</div>
			}
			if d.Backups.Ready && len(d.Backups.Runs) == 0 && len(d.Backups.Restores) == 0 {
				@emptyState("history", t(ctx, "backups.history.empty"))
			}
			if len(d.Backups.Runs) > 0 {
				@backupRunsTable(d.Backups.Runs, false, d.CanAdmin, d.SudoCritical)
			}
			@cursorPager(d.Backups.RunsPage)
		</section>
		if len(d.Backups.Restores) > 0 {
			<section class={ cardClass }>
				@cardHead(t(ctx, "svcbackup.restores"))
				<div class="tuc-table-wrap">
					<table class="tuc-table is-compact w-full">
						<thead><tr><th>{ t(ctx, "backups.history.when") }</th><th>{ t(ctx, "svcbackup.restore_dest") }</th><th>{ t(ctx, "backups.history.result") }</th></tr></thead>
						<tbody>
							for _, r := range d.Backups.Restores {
								<tr title={ r.What }>
									<td class="whitespace-nowrap text-muted">{ r.When }</td>
									<td class="font-mono text-[13px] whitespace-nowrap">
										{ r.Dest }
										if r.From != "" {
											<span class="block font-sans text-xs text-subtle">{ t(ctx, "svcbackup.restore_from_service", "service", r.From) }</span>
										}
									</td>
									<td>
										<span class={ badgeTone(r.Tone) }>{ r.Status }</span>
										if r.Step != "" {
											<span class="block text-xs text-subtle">{ r.Step }</span>
										}
										if r.Error != "" {
											<span class="mt-1 block line-clamp-3 font-mono text-xs break-words text-danger" title={ r.Error }>{ r.Error }</span>
										}
										if r.Cleanup != "" {
											<span class="block text-xs text-muted">{ r.Cleanup }</span>
										}
										if r.Saved != "" {
											<span class="mt-1 block text-xs text-muted">{ r.Saved }</span>
										}
										if r.Roles != "" {
											<span class="mt-1 block text-xs text-warning">{ r.Roles }</span>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		}
		if d.CanAdmin && d.Backups.Ready && d.SudoCritical {
			@svcBackupRestore(d)
		}
	}
}

// svcBackupRoutines lists when the service is backed up by itself. None
// by default (no automatic backup); a routine is added and changed in a
// dialog. The schedule holds one routine: every N hours from a time.
templ svcBackupRoutines(d ServiceData) {
	<section class={ cardClass }>
		@cardHead(t(ctx, "svcbackup.routines")) {
			if d.CanAdmin && !d.Backups.Enabled {
				<button type="button" class="tuc-btn is-primary is-sm" data-tuc-modal="#routine-modal">
					@Icon("plus", "size-3.5")
					{ t(ctx, "svcbackup.routine_add") }
				</button>
			}
		}
		if !d.Backups.Enabled {
			@emptyState("clock", t(ctx, "svcbackup.routines_empty"))
		} else {
			// One row: the clock, when it runs (how Hangar copies it in the
			// tooltip) and the next run, edit and remove on the right.
			<div class="flex items-center gap-3 px-4 py-3">
				<span class="inline-flex size-9 shrink-0 items-center justify-center rounded-sm bg-surface-2 text-muted">
					@Icon("clock", "size-4")
				</span>
				<div class="flex min-w-0 grow flex-col gap-0.5">
					<span class="truncate text-sm font-medium" title={ methodText(ctx, d.Backups.Method) }>{ routineText(ctx, d.Backups.EveryHours, d.Backups.AtTime) }</span>
					if d.Backups.NextRun != "" {
						<span class="text-xs text-muted">{ t(ctx, "svcbackup.next", "when", d.Backups.NextRun) }</span>
					}
				</div>
				if d.CanAdmin {
					<span class="inline-flex shrink-0 items-center gap-1 [&_form]:inline-flex">
						<button type="button" class="tuc-btn is-ghost is-icon is-sm" data-tuc-modal="#routine-modal" title={ t(ctx, "svcbackup.routine_edit") } aria-label={ t(ctx, "svcbackup.routine_edit") }>
							@Icon("pencil", "size-3.5")
						</button>
						// Turning the routine off needs a recent password (SEC-016).
						if d.SudoCritical {
							<form method="post" action={ templ.SafeURL(d.base() + "/backups/policy") } data-confirm={ t(ctx, "confirm.routine_remove.title") } data-confirm-text={ t(ctx, "confirm.routine_remove.text") } data-confirm-ok={ t(ctx, "confirm.routine_remove.ok") } data-tone="warning">
								<input type="hidden" name="csrf" value={ d.CSRF }/>
								<input type="hidden" name="every_hours" value={ fmt.Sprint(d.Backups.EveryHours) }/>
								<input type="hidden" name="at" value={ d.Backups.AtTime }/>
								if d.Backups.WAL {
									<input type="hidden" name="wal" value="1"/>
								}
								<button class="tuc-btn is-ghost is-icon is-sm text-danger" type="submit" title={ t(ctx, "svcbackup.routine_remove") } aria-label={ t(ctx, "svcbackup.routine_remove") }>
									@Icon("trash", "size-3.5")
								</button>
							</form>
						} else {
							<button type="button" class="tuc-btn is-ghost is-icon is-sm text-danger" data-tuc-modal="#sudo-dialog" title={ t(ctx, "svcbackup.routine_remove") } aria-label={ t(ctx, "svcbackup.routine_remove") }>
								@Icon("trash", "size-3.5")
							</button>
						}
					</span>
				}
			</div>
		}
	</section>
	if d.CanAdmin {
		@svcRoutineDialog(d)
	}
}

// methodText says how Hangar backs the service up (its choice, never
// asked): the routine's tooltip.
func methodText(ctx context.Context, method string) string {
	if method == "" {
		return ""
	}
	return t(ctx, "svcbackup.method."+method)
}

// routineText says when the routine runs: "every day at 03:00" for the
// usual daily one.
func routineText(ctx context.Context, hours int, at string) string {
	if hours == 24 {
		return t(ctx, "svcbackup.routine_daily", "at", at)
	}
	return t(ctx, "svcbackup.routine_text", "n", hours, "at", at)
}

// routineTimes are the start times offered: whole hours, plus the
// current one when it was set to another minute.
func routineTimes(current string) []string {
	out := make([]string, 0, 25)
	for h := range 24 {
		out = append(out, fmt.Sprintf("%02d:00", h))
	}
	if current != "" && !slices.Contains(out, current) {
		out = append(out, current)
		slices.Sort(out)
	}
	return out
}

// svcRoutineDialog adds or changes the routine: how often, from what time.
// "Back to any minute" (WAL) is advanced: it shows only while on, so it
// can be turned off.
templ svcRoutineDialog(d ServiceData) {
	<dialog class="tuc-modal is-md" id="routine-modal" aria-labelledby="routine-modal-title" data-open={ fmt.Sprint(d.Backups.OpenRoutine) }>
		<div class="tuc-modal__panel">
			<div class="tuc-modal__header">
				<h2 class="tuc-modal__title" id="routine-modal-title">{ t(ctx, "svcbackup.routine_title") }</h2>
				<button type="button" class="tuc-btn is-ghost is-icon is-sm tuc-modal__close" data-tuc-modal-close aria-label={ t(ctx, "tucano.close") }>
					@Icon("x", "size-4")
				</button>
			</div>
			<form class="tuc-modal__body" method="post" action={ templ.SafeURL(d.base() + "/backups/policy") }>
				<input type="hidden" name="csrf" value={ d.CSRF }/>
				<input type="hidden" name="enabled" value="1"/>
				<p class="tuc-modal__text">{ t(ctx, "svcbackup.routine_hint") }</p>
				<div class="grid grid-cols-2 gap-3">
					<div class="flex min-w-0 flex-col gap-1.5">
						<label class="tuc-label" for="bk-every">{ t(ctx, "svcbackup.every") }</label>
						<select class="tuc-input" id="bk-every" name="every_hours" data-tuc-select data-clearable="false">
							for _, h := range everyHours {
								<option value={ fmt.Sprint(h) } selected?={ h == d.Backups.EveryHours }>{ t(ctx, "svcbackup.every_hours", "n", h) }</option>
							}
						</select>
					</div>
					<div class="flex min-w-0 flex-col gap-1.5">
						<label class="tuc-label" for="bk-at">{ t(ctx, "svcbackup.at") }</label>
						<select class="tuc-input" id="bk-at" name="at" data-tuc-select data-clearable="false">
							for _, at := range routineTimes(d.Backups.AtTime) {
								<option value={ at } selected?={ at == d.Backups.AtTime }>{ at }</option>
							}
						</select>
					</div>
				</div>
				if d.Backups.WALSupported && d.Backups.WAL {
					if d.SudoCritical {
						<label class="tuc-choice is-end">
							<input type="checkbox" role="switch" class="tuc-switch" name="wal" value="1" checked/>
							<span>{ t(ctx, "svcbackup.wal") }</span>
						</label>
					} else {
						// Turning WAL off needs a recent password (SEC-016): the
						// switch stays on here and the schedule can still change.
						<input type="hidden" name="wal" value="1"/>
						<label class="tuc-choice is-end">
							<input type="checkbox" role="switch" class="tuc-switch" checked disabled/>
							<span>{ t(ctx, "svcbackup.wal") }</span>
						</label>
						<p class="tuc-hint">{ t(ctx, "svcbackup.wal_sudo") }</p>
					}
				}
				<div class="flex justify-end gap-2">
					<button type="button" class="tuc-btn is-ghost" data-tuc-modal-close>{ t(ctx, "tucano.cancel") }</button>
					<button class="tuc-btn is-primary" type="submit">
						@Icon("save", "size-3.5")
						{ t(ctx, "svcbackup.save") }
					</button>
				</div>
			</form>
		</div>
	</dialog>
}

templ svcBackupWAL(d ServiceData) {
	<section class={ cardClass }>
		@cardHead(t(ctx, "svcbackup.wal_title")) {
			<span class={ badgeTone(d.Backups.WALTone) }>{ d.Backups.WALState }</span>
		}
		<div class={ cardBodyClass }>
			@pendingBanner(d)
			if d.Backups.WindowOK {
				<p class="m-0 text-[13px]">{ d.Backups.Window }</p>
			} else {
				<p class="m-0 text-[13px] text-muted">{ t(ctx, "svcbackup.window_none") }</p>
			}
			if d.Backups.LastBase != "" {
				<span class="text-xs text-muted">{ t(ctx, "svcbackup.last_base", "when", d.Backups.LastBase) }</span>
			}
		</div>
	</section>
}

// svcBackupActions are the history card's buttons: a backup that goes to
// the destination now, and a pg_dump downloaded in the browser.
templ svcBackupActions(d ServiceData) {
	if d.CanOperate && d.Backups.Ready {
		<form class="inline-flex" method="post" action={ templ.SafeURL(d.base() + "/backups/run") }>
			<input type="hidden" name="csrf" value={ d.CSRF }/>
			<button class="tuc-btn is-outline is-sm" type="submit" disabled?={ d.Backups.Busy }>
				if d.Backups.Busy {
					<span class="tuc-spinner" aria-hidden="true"></span>
					{ t(ctx, "svcbackup.running_now") }
				} else {
					@Icon("database-backup", "size-3.5")
					{ t(ctx, "svcbackup.run_now") }
				}
			</button>
		</form>
	}
	if d.CanAdmin && len(d.Backups.Dumps) > 0 {
		<button type="button" class="tuc-btn is-outline is-sm" data-tuc-modal={ restoreModal(d) }>
			@Icon("archive-restore", "size-3.5")
			{ t(ctx, "svcbackup.restore") }
		</button>
	}
	// The download needs no destination (pg_dump streams straight to the
	// browser, encrypted when a kit exists), so it shows in the not-ready
	// state too: it is the way out for a database nobody has set up yet.
	if d.CanAdmin {
		if d.SudoCritical {
			<form class="inline-flex" method="post" action={ templ.SafeURL(d.base() + "/backup") } title={ downloadHint(ctx, d.Backups.HasKit, d.Backups.Method) }>
				<input type="hidden" name="csrf" value={ d.CSRF }/>
				<button class="tuc-btn is-outline is-sm" type="submit">
					@Icon("download", "size-3.5")
					{ t(ctx, "backup.download") }
				</button>
			</form>
		} else {
			@sudoButton(t(ctx, "backup.download"))
		}
	}
}

// downloadHint says what the download does: the whole service, its data
// and its configuration, in one .zip. A PostgreSQL streams its plain dump
// before a kit exists; everything else is made first and offered as a
// link, encrypted once a kit exists.
func downloadHint(ctx context.Context, kit bool, method string) string {
	switch {
	case method == "recipe" && kit:
		return t(ctx, "svcbackup.download_hint_recipe")
	case method == "recipe":
		return t(ctx, "backup.hint_recipe")
	case method != "pg_dump" && kit:
		return t(ctx, "svcbackup.download_hint_volumes")
	case method != "pg_dump":
		return t(ctx, "backup.hint_volumes")
	case kit:
		return t(ctx, "svcbackup.download_hint")
	}
	return t(ctx, "backup.hint")
}

// restoreConfirm is the restore's confirmation text.
func restoreConfirm(ctx context.Context, volumes bool) string {
	if volumes {
		return t(ctx, "confirm.restore.text_volumes")
	}
	return t(ctx, "confirm.restore.text")
}

// restoreModal opens the restore dialog, or the identity check first.
func restoreModal(d ServiceData) string {
	if d.SudoCritical {
		return "#restore-modal"
	}
	return "#sudo-dialog"
}

// svcNextRun is the frequency row's hint: when the next backup runs.
func svcNextRun(ctx context.Context, next string) string {
	if next == "" {
		return t(ctx, "svcbackup.every_hint")
	}
	return t(ctx, "svcbackup.next", "when", next)
}

templ svcDownloadState(dl DownloadView, sudo, volumes bool) {
	if dl.Error != "" {
		@errorAlert(t(ctx, "svcbackup.download_failed", "error", dl.Error))
	} else if !dl.Ready {
		<span class="flex items-center gap-2 text-[13px] text-muted">
			<span class="tuc-spinner" aria-hidden="true"></span>
			if volumes {
				{ t(ctx, "svcbackup.download_preparing_volumes") }
			} else {
				{ t(ctx, "svcbackup.download_preparing") }
			}
		</span>
	} else if sudo {
		<div class="flex flex-col gap-1">
			<a class="tuc-btn is-success" href={ templ.SafeURL("/backups/download/" + dl.Token) }>
				@Icon("download", "size-3.5")
				{ t(ctx, "svcbackup.download_ready", "size", dl.Size) }
			</a>
			<span class="tuc-hint">{ t(ctx, "svcbackup.download_expires", "when", dl.Expires) }</span>
		</div>
	}
}

// svcBackupRestore is docs/09 "Restaurar pelo painel": point, destination,
// kit. The kit's private key goes only with this request, stays in memory
// and is dropped when the restore ends.
templ svcBackupRestore(d ServiceData) {
	<dialog class="tuc-modal is-md" id="restore-modal" aria-labelledby="restore-modal-title">
		<div class="tuc-modal__panel">
			<div class="tuc-modal__header">
				<h2 class="tuc-modal__title" id="restore-modal-title">{ t(ctx, "svcbackup.restore_title") }</h2>
				<button type="button" class="tuc-btn is-ghost is-icon is-sm tuc-modal__close" data-tuc-modal-close aria-label={ t(ctx, "tucano.close") }>
					@Icon("x", "size-4")
				</button>
			</div>
			<form class="tuc-modal__body" method="post" action={ templ.SafeURL(d.base() + "/backups/restore") } enctype="multipart/form-data" data-confirm={ t(ctx, "confirm.restore.title") } data-confirm-text={ restoreConfirm(ctx, d.Backups.Volumes) } data-confirm-ok={ t(ctx, "confirm.restore.ok") } data-tone="danger">
				<input type="hidden" name="csrf" value={ d.CSRF }/>
				<input type="hidden" name="tz_offset" value="" data-tz-offset/>
				if d.Backups.WindowOK {
					<fieldset class="tuc-choices">
						<legend class="tuc-label">{ t(ctx, "svcbackup.restore_point") }</legend>
						if d.Backups.WindowOK {
							<label class="tuc-choice">
								<input type="radio" class="tuc-radio" name="mode" value="pitr" checked/>
								<span>{ t(ctx, "svcbackup.mode_pitr") } <span class="tuc-choice__hint">{ d.Backups.Window }</span></span>
							</label>
							<div class="ml-7 flex max-w-[280px] flex-col gap-1.5">
								<label class="tuc-label" for="rs-at">{ t(ctx, "svcbackup.at_moment") }</label>
								<input class="tuc-input" id="rs-at" name="at" data-tuc-datepicker data-time="true" data-minute-step="1" data-max={ d.Backups.MaxAt } data-today="true"/>
							</div>
						}
						<label class="tuc-choice">
							<input type="radio" class="tuc-radio" name="mode" value="dump" checked?={ !d.Backups.WindowOK } disabled?={ len(d.Backups.Dumps) == 0 }/>
							<span>{ t(ctx, "svcbackup.mode_dump") } <span class="tuc-choice__hint">{ t(ctx, "svcbackup.mode_dump_hint") }</span></span>
						</label>
						if len(d.Backups.Dumps) > 0 {
							<div class="ml-7 flex max-w-[420px] flex-col gap-1.5">
								<label class="tuc-label" for="rs-key">{ t(ctx, "svcbackup.dump_choice") }</label>
								<select class="tuc-input" id="rs-key" name="key" data-tuc-select data-clearable="false">
									for _, k := range d.Backups.Dumps {
										<option value={ k.Key }>{ k.Label }</option>
									}
								</select>
							</div>
						}
					</fieldset>
				} else {
					<input type="hidden" name="mode" value="dump"/>
					<div class="flex flex-col gap-1.5">
						<label class="tuc-label" for="rs-key">{ t(ctx, "svcbackup.dump_choice") }</label>
						<select class="tuc-input" id="rs-key" name="key" data-tuc-select data-clearable="false">
							for _, k := range d.Backups.Dumps {
								<option value={ k.Key }>{ k.Label }</option>
							}
						</select>
					</div>
				}
				<fieldset class="tuc-choices">
					<legend class="tuc-label">{ t(ctx, "svcbackup.restore_dest") }</legend>
					<label class="tuc-choice">
						<input type="radio" class="tuc-radio" name="destination" value="new" checked/>
						<span>{ t(ctx, "svcbackup.dest_new") } <span class="tuc-choice__hint">{ t(ctx, "svcbackup.dest_new_hint") }</span></span>
					</label>
					<div class="ml-7 flex max-w-[280px] flex-col gap-1.5">
						<label class="tuc-label" for="rs-new">{ t(ctx, "svcbackup.new_name") }</label>
						<input class="tuc-input font-mono" id="rs-new" name="new_service" value={ d.Backups.DefaultNew } pattern="[a-z][a-z0-9\-]{0,30}[a-z0-9]" maxlength="32"/>
					</div>
					<label class="tuc-choice">
						<input type="radio" class="tuc-radio" name="destination" value="overwrite"/>
						<span>{ t(ctx, "svcbackup.dest_overwrite") } <span class="tuc-choice__hint">{ t(ctx, "svcbackup.dest_overwrite_hint") }</span></span>
					</label>
					<div class="ml-7 max-w-[320px]">
						@confirmName("rs-confirm", t(ctx, "svcbackup.confirm_name"), d.Slug, false)
					</div>
				</fieldset>
				if !d.Backups.Simple {
					<div class="grid grid-cols-[repeat(auto-fit,minmax(min(260px,100%),1fr))] gap-3">
						<div class="flex min-w-0 flex-col gap-1.5">
							<span class="tuc-label is-required">{ t(ctx, "svcbackup.kit") }</span>
							<input id="rs-kit" name="kit" type="file" accept=".txt,.age,text/plain" data-tuc-upload data-max-size="64KB" aria-label={ t(ctx, "svcbackup.kit") }/>
							<span class="tuc-hint">{ t(ctx, "svcbackup.kit_hint") }</span>
						</div>
						<div class="flex min-w-0 flex-col gap-1.5">
							<label class="tuc-label" for="rs-pass">{ t(ctx, "svcbackup.passphrase") }</label>
							<input class="tuc-input" id="rs-pass" name="passphrase" type="password" autocomplete="off" data-tuc-reveal/>
							<span class="tuc-hint">{ t(ctx, "svcbackup.passphrase_hint") }</span>
						</div>
					</div>
				}
				<label class="tuc-choice">
					<input type="checkbox" class="tuc-check" name="allow_unverified" value="1"/>
					<span>{ t(ctx, "svcbackup.allow_unverified") } <span class="tuc-choice__hint">{ t(ctx, "svcbackup.allow_unverified_hint") }</span></span>
				</label>
				<div class="flex justify-end gap-2">
					<button type="button" class="tuc-btn is-ghost" data-tuc-modal-close>{ t(ctx, "tucano.cancel") }</button>
					<button class="tuc-btn is-danger" type="submit">
						@Icon("archive-restore", "size-3.5")
						{ t(ctx, "svcbackup.restore") }
					</button>
				</div>
			</form>
		</div>
	</dialog>
}
