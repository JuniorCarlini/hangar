package views

import (
	"context"
	"fmt"
)

// Backups screens (docs/09): the overview, the recovery kit generated in
// the browser, the destination form and the service's Backups tab.

// BackupsData feeds the backups overview.
type BackupsData struct {
	CSRF       string
	CanOperate bool
	CanAdmin   bool
	CanOwner   bool
	SudoActive bool
	Ready      bool
	// PanelQueued: the panel's own "back up now" waits or runs.
	PanelQueued bool
	Tab         string // "" (the backups) or "config" (kit and destinations)
	Simple      bool   // the server keeps its own key: no kit needed
	ServerKey   string // the simple mode's key, on the response that reveals it
	Alerts      []BackupAlert
	Keys        []BackupKeyRow
	Targets     []BackupTargetRow
	Services    []BackupServiceRow
	Panel       BackupServiceRow
	Runs        []BackupRunRow
	Folders     []BackupFolder
	Error       string
	Flash       string
}

// BackupAlert is an alert already in the user's language.
type BackupAlert struct {
	Tone string // "danger" or "warning"
	Text string
}

// BackupKeyRow is a public key of a recovery kit.
type BackupKeyRow struct {
	ID        string
	Label     string
	Public    string
	Created   string
	Confirmed bool
	Due       bool // confirmed long ago: asked to prove it is still kept
}

// BackupTargetRow is a destination.
type BackupTargetRow struct {
	ID       string
	Name     string
	Provider string
	Where    string
	Lock     string
	Checked  string
	Error    string
	Primary  bool
}

// BackupServiceRow is a line of the services table.
type BackupServiceRow struct {
	Label    string
	Href     string
	Schedule string
	Last     string
	LastTone string // badge tone of the last backup
	WAL      string
	WALTone  string
	Size     string
	Tested   bool
	HasRun   bool
	// Covered: a routine backs it up by itself; without one it shows as
	// not backed up, with a way to create it.
	Covered bool
}

// BackupRunRow is one backup in the history.
type BackupRunRow struct {
	ID       string
	When     string
	Label    string
	Kind     string
	Class    string
	Trigger  string
	Size     string
	Status   string
	Tone     string
	Verified bool
	Checked  string // "3 tabelas, 1.500 linhas"
	Uploads  string
	Warning  string
	Error    string
	CanLink  bool
}

// BackupFolder is a bucket folder and how long its lifecycle rule keeps it.
type BackupFolder struct {
	Folder string
	Days   int
	What   string
}

func badgeTone(tone string) string {
	switch tone {
	case "success", "warning", "danger", "info":
		return "tuc-badge is-" + tone
	}
	return "tuc-badge"
}

func alertTone(tone string) string {
	if tone == "danger" {
		return "tuc-alert is-danger"
	}
	return "tuc-alert is-warning"
}

// Backups is the backups overview (docs/09 "Tela de Backups"): what was
// backed up, and in a second tab the kit and the destinations.
templ Backups(d BackupsData) {
	@shell(t(ctx, "backups.page_title")) {
		if d.PanelQueued {
			// ui.js reloads once the backup is over (data-busy-poll).
			<span hidden data-busy-poll></span>
		}
		@pageHead(t(ctx, "backups.title"), "") {
			if d.CanOperate && d.Ready {
				<form method="post" action="/backups/panel">
					<input type="hidden" name="csrf" value={ d.CSRF }/>
					<button class="tuc-btn is-outline" type="submit" disabled?={ d.PanelQueued }>
						if d.PanelQueued {
							<span class="tuc-spinner" aria-hidden="true"></span>
							{ t(ctx, "svcbackup.running_now") }
						} else {
							@Icon("database-backup", "size-3.5")
							{ t(ctx, "backups.panel_now") }
						}
					</button>
				</form>
			}
		}
		@pageBody() {
			@errorAlert(d.Error)
			@toast("success", d.Flash)
			for _, a := range d.Alerts {
				<div class={ alertTone(a.Tone) } role="status">
					@Icon("triangle-alert", "size-4")
					<div class="tuc-alert__body"><p>{ a.Text }</p></div>
				</div>
			}
			<div class="tuc-tabs">
				<div class="tuc-tabs__list" role="tablist" aria-label={ t(ctx, "backups.title") }>
					<a class="tuc-tabs__tab" role="tab" aria-selected={ tabClass(d.Tab, "") } href="/backups">{ t(ctx, "backups.tab.list") }</a>
					<a class="tuc-tabs__tab" role="tab" aria-selected={ tabClass(d.Tab, "config") } href="/backups?tab=config">{ t(ctx, "backups.tab.config") }</a>
				</div>
			</div>
			if d.Tab == "config" {
				@backupMode(d)
				if !d.Simple || len(d.Keys) > 0 {
					@backupKeys(d)
				}
				@backupTargets(d)
				@backupRules(d)
				<script src={ asset("kit.js") } defer></script>
			} else {
				if !d.Ready {
					<section class={ cardClass }>
						@emptyState("database-backup", notReadyText(ctx, d.Simple, "backups")) {
							<a class="tuc-btn is-primary is-sm" href="/backups?tab=config">
								@Icon("settings", "size-3.5")
								{ t(ctx, "backups.tab.open_config") }
							</a>
						}
					</section>
				}
				@backupServices(d)
				@backupHistory(d)
			}
			if d.CanAdmin {
				@sudoModal(d.CSRF, "/backups?tab="+d.Tab, d.SudoActive)
			}
		}
	}
}

// notReadyText says what is missing before backups can run: in the
// simple mode only a destination.
func notReadyText(ctx context.Context, simple bool, section string) string {
	switch {
	case section == "svcbackup" && simple:
		return t(ctx, "svcbackup.not_ready_simple")
	case section == "svcbackup":
		return t(ctx, "svcbackup.not_ready")
	case simple:
		return t(ctx, "backups.not_ready_simple")
	}
	return t(ctx, "backups.not_ready")
}

// backupMode chooses how backups are encrypted: the simple mode (the
// server keeps the key) or the recovery kit (only who holds it opens them).
templ backupMode(d BackupsData) {
	<section class={ cardClass } id="backup-mode">
		@cardHead(t(ctx, "backups.mode.title"))
		<div class={ cardBodyClass }>
			if d.CanOwner {
				<form method="post" action="/backups/mode" class="flex flex-col gap-3">
					<input type="hidden" name="csrf" value={ d.CSRF }/>
					<fieldset class="tuc-choices">
						<legend class="sr-only">{ t(ctx, "backups.mode.title") }</legend>
						<label class="tuc-choice">
							<input type="radio" class="tuc-radio" name="mode" value="simple" checked?={ d.Simple }/>
							<span>{ t(ctx, "backups.mode.simple") } <span class="tuc-choice__hint">{ t(ctx, "backups.mode.simple_hint") }</span></span>
						</label>
						<label class="tuc-choice">
							<input type="radio" class="tuc-radio" name="mode" value="kit" checked?={ !d.Simple }/>
							<span>{ t(ctx, "backups.mode.kit") } <span class="tuc-choice__hint">{ t(ctx, "backups.mode.kit_hint") }</span></span>
						</label>
					</fieldset>
					<div class="flex justify-end">
						if d.SudoActive {
							<button class="tuc-btn is-outline" type="submit">
								@Icon("save", "size-4")
								{ t(ctx, "backups.mode.save") }
							</button>
						} else {
							@sudoButton(t(ctx, "backups.mode.save"))
						}
					</div>
				</form>
			} else {
				<p class="m-0 text-[13px] text-muted">
					if d.Simple {
						{ t(ctx, "backups.mode.simple") }
					} else {
						{ t(ctx, "backups.mode.kit") }
					}
				</p>
			}
			if d.Simple && d.CanOwner {
				<div class="flex flex-wrap items-center gap-3 border-t border-border pt-3">
					<div class="flex min-w-0 flex-[1_1_240px] flex-col gap-0.5">
						<span class="text-sm font-semibold">{ t(ctx, "backups.mode.key") }</span>
						<span class="text-[13px] text-muted">{ t(ctx, "backups.mode.key_hint") }</span>
					</div>
					if d.ServerKey != "" {
						<div class="flex min-w-0 flex-[1_1_280px] items-center gap-2">
							<input class="tuc-input min-w-0 grow font-mono text-xs" value={ d.ServerKey } readonly aria-label={ t(ctx, "backups.mode.key") }/>
							<button type="button" class="tuc-btn is-outline is-sm" data-copy={ d.ServerKey } data-copied={ t(ctx, "common.copied") }>
								@copyIcon()
								{ t(ctx, "export.copy") }
							</button>
						</div>
					} else if d.SudoActive {
						<form method="post" action="/backups/server-key">
							<input type="hidden" name="csrf" value={ d.CSRF }/>
							<button class="tuc-btn is-outline is-sm" type="submit">
								@Icon("eye", "size-3.5")
								{ t(ctx, "backups.mode.key_show") }
							</button>
						</form>
					} else {
						@sudoButton(t(ctx, "backups.mode.key_show"))
					}
				</div>
			}
		</div>
	</section>
}

// backupKeys carries kit.js's messages: the confirmation reads the kit
// file in the browser.
templ backupKeys(d BackupsData) {
	<section
		class={ cardClass }
		id="kit-app"
		data-mismatch={ t(ctx, "kit.mismatch") }
		data-no-key={ t(ctx, "kit.no_key") }
		data-file-ok={ t(ctx, "kit.file_ok") }
	>
		@cardHead(t(ctx, "backups.keys.title")) {
			if d.CanOwner && len(d.Keys) > 0 {
				<a class="tuc-btn is-outline is-sm" href="/backups/kit">
					@Icon("key-round", "size-3.5")
					{ t(ctx, "backups.kit_generate") }
				</a>
			}
		}
		if len(d.Keys) == 0 {
			@emptyState("key-round", t(ctx, "backups.keys.empty")) {
				if d.CanOwner {
					<a class="tuc-btn is-primary is-sm" href="/backups/kit">
						@Icon("key-round", "size-3.5")
						{ t(ctx, "backups.kit_generate") }
					</a>
				}
			}
		} else {
			<div class="tuc-table-wrap">
				<table class="tuc-table is-compact w-full">
					<thead><tr><th>{ t(ctx, "backups.keys.label") }</th><th>{ t(ctx, "backups.keys.public") }</th><th>{ t(ctx, "backups.keys.state") }</th><th>{ t(ctx, "backups.keys.created") }</th><th class="tuc-table__actions"></th></tr></thead>
					<tbody>
						for _, k := range d.Keys {
							<tr>
								<td>{ k.Label }</td>
								<td class="max-w-[280px] truncate font-mono text-xs" title={ k.Public }>{ k.Public }</td>
								<td>
									if k.Due {
										<span class="tuc-badge is-warning" title={ t(ctx, "backups.keys.due_hint") }>{ t(ctx, "backups.keys.due") }</span>
									} else if k.Confirmed {
										<span class="tuc-badge is-success">{ t(ctx, "backups.keys.confirmed") }</span>
									} else {
										<span class="tuc-badge is-warning">{ t(ctx, "backups.keys.pending") }</span>
									}
								</td>
								<td class="text-muted">{ k.Created }</td>
								<td class="tuc-table__actions">
									if d.CanOwner && d.SudoActive {
										<form data-confirm={ t(ctx, "confirm.backup_key_delete.title") } data-confirm-text={ t(ctx, "confirm.backup_key_delete.text") } data-confirm-ok={ t(ctx, "confirm.backup_key_delete.ok") } data-tone="danger" method="post" action="/backups/keys/delete">
											<input type="hidden" name="csrf" value={ d.CSRF }/>
											<input type="hidden" name="id" value={ k.ID }/>
											<button class="tuc-btn is-ghost is-icon is-sm" type="submit" aria-label={ t(ctx, "backups.keys.delete", "label", k.Label) }>
												@Icon("trash", "size-3.5")
											</button>
										</form>
									}
								</td>
							</tr>
							if (!k.Confirmed || k.Due) && d.CanOwner {
								<tr>
									<td colspan="5">
										@kitConfirmForm(d.CSRF, k, d.SudoActive)
									</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		}
		if d.CanOwner && !d.SudoActive && len(d.Keys) > 0 {
			<div class="border-t border-border p-4">
				@sudoForm(d.CSRF, "/backups", t(ctx, "backups.sudo_label"))
			</div>
		}
	</section>
}

// kitConfirmForm proves the kit was kept: the file is read in the
// browser (kit.js) and only the code is sent; the code can also be typed.
templ kitConfirmForm(csrf string, k BackupKeyRow, sudo bool) {
	<form method="post" action="/backups/keys/confirm" class="flex flex-col gap-3 py-2">
		<input type="hidden" name="csrf" value={ csrf }/>
		<input type="hidden" name="id" value={ k.ID }/>
		<div class="flex min-w-0 flex-col gap-1.5">
			<span class="tuc-label">{ t(ctx, "backups.keys.confirm_file") }</span>
			// The file is read here in the browser (kit.js): only the code it
			// yields fills the field below and is sent.
			<input type="file" id={ "kit-file-" + k.ID } accept=".txt,.age,text/plain" data-tuc-upload data-max-size="64KB" data-kit-file data-public={ k.Public } aria-label={ t(ctx, "backups.keys.confirm_file") }/>
			<span class="tuc-hint" data-kit-file-msg aria-live="polite">{ t(ctx, "backups.keys.confirm_file_hint") }</span>
		</div>
		<div class="flex flex-wrap items-end gap-3">
			<div class="flex min-w-[200px] flex-[0_1_260px] flex-col gap-1.5">
				<label class="tuc-label" for={ "kit-code-" + k.ID }>{ t(ctx, "backups.keys.code") }</label>
				<input class="tuc-input font-mono uppercase" id={ "kit-code-" + k.ID } name="code" required maxlength="14" autocomplete="off" spellcheck="false" placeholder={ "XXXX-XXXX-XXXX" } data-tuc-mask="****-****-****"/>
			</div>
			if sudo {
				<button class="tuc-btn is-success" type="submit">
					@Icon("shield-check", "size-3.5")
					{ t(ctx, "backups.keys.confirm") }
				</button>
			}
		</div>
	</form>
}

templ backupTargets(d BackupsData) {
	<section class={ cardClass }>
		@cardHead(t(ctx, "backups.targets.title")) {
			if d.CanOwner && len(d.Targets) > 0 {
				<a class="tuc-btn is-outline is-sm" href="/backups/targets/new">
					@Icon("plus", "size-3.5")
					{ t(ctx, "backups.target_add") }
				</a>
			}
		}
		if len(d.Targets) == 0 {
			@emptyState("cloud-upload", t(ctx, "backups.targets.empty")) {
				if d.CanOwner {
					<a class="tuc-btn is-primary is-sm" href="/backups/targets/new">
						@Icon("plus", "size-3.5")
						{ t(ctx, "backups.target_add") }
					</a>
				}
			}
		} else {
			<div class="tuc-table-wrap">
				<table class="tuc-table is-compact w-full">
					<thead><tr><th>{ t(ctx, "backups.targets.name") }</th><th>{ t(ctx, "backups.targets.where") }</th><th>{ t(ctx, "backups.targets.lock") }</th><th>{ t(ctx, "backups.targets.check") }</th><th class="tuc-table__actions"></th></tr></thead>
					<tbody>
						for _, tg := range d.Targets {
							<tr>
								<td>
									{ tg.Name }
									if tg.Primary {
										<span class="tuc-badge is-info is-plain ml-1.5">{ t(ctx, "backups.targets.primary") }</span>
									}
								</td>
								<td class="max-w-[320px] truncate font-mono text-xs">{ tg.Where }</td>
								<td>
									<span class="tuc-badge is-success">
										@Icon("lock", "size-3")
										{ tg.Lock }
									</span>
								</td>
								<td>
									if tg.Error != "" {
										<span class="tuc-badge is-danger" title={ tg.Error }>{ t(ctx, "backups.targets.failed") }</span>
									} else {
										<span class="text-xs text-muted">{ tg.Checked }</span>
									}
								</td>
								<td class="tuc-table__actions">
									<div class="flex justify-end gap-1 [&_form]:inline-flex">
										if d.CanAdmin {
											<form method="post" action="/backups/targets/check">
												<input type="hidden" name="csrf" value={ d.CSRF }/>
												<input type="hidden" name="id" value={ tg.ID }/>
												<button class="tuc-btn is-outline is-sm" type="submit">
													@Icon("refresh-cw", "size-3.5")
													{ t(ctx, "backups.targets.test") }
												</button>
											</form>
										}
										if d.CanOwner && d.SudoActive {
											<form data-confirm={ t(ctx, "confirm.backup_target_delete.title") } data-confirm-text={ t(ctx, "confirm.backup_target_delete.text") } data-confirm-ok={ t(ctx, "confirm.backup_target_delete.ok") } data-tone="danger" method="post" action="/backups/targets/delete">
												<input type="hidden" name="csrf" value={ d.CSRF }/>
												<input type="hidden" name="id" value={ tg.ID }/>
												<button class="tuc-btn is-ghost is-icon is-sm" type="submit" aria-label={ t(ctx, "backups.targets.delete", "name", tg.Name) }>
													@Icon("trash", "size-3.5")
												</button>
											</form>
										}
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

templ backupServices(d BackupsData) {
	<section class={ cardClass }>
		@cardHead(t(ctx, "backups.services.title"))
		<div class="tuc-table-wrap">
			<table class="tuc-table is-compact w-full">
				<thead><tr><th>{ t(ctx, "backups.services.service") }</th><th>{ t(ctx, "backups.services.schedule") }</th><th>{ t(ctx, "backups.services.last") }</th><th class="tuc-table__actions"></th></tr></thead>
				<tbody>
					for _, s := range d.Services {
						@backupServiceRow(s, true)
					}
					@backupServiceRow(d.Panel, false)
				</tbody>
			</table>
		</div>
	</section>
}

templ backupServiceRow(s BackupServiceRow, link bool) {
	<tr>
		<td class="font-mono text-[13px]">
			if link {
				{ s.Label }
			} else {
				<span class="flex items-center gap-1.5 font-sans">
					@Icon("server", "size-3.5 text-muted")
					{ t(ctx, "backups.services.panel") }
				</span>
			}
		</td>
		<td class="text-muted">
			if link && !s.Covered {
				<span class="tuc-badge is-warning">{ t(ctx, "backups.services.none") }</span>
			} else {
				{ s.Schedule }
			}
		</td>
		<td>
			if s.HasRun {
				<span class={ badgeTone(s.LastTone) }>{ s.Last }</span>
			} else {
				<span class="text-muted">—</span>
			}
		</td>
		<td class="tuc-table__actions">
			if link && !s.Covered {
				<a class="tuc-btn is-outline is-sm" href={ templ.SafeURL(s.Href) }>
					@Icon("plus", "size-3.5")
					{ t(ctx, "backups.services.create") }
				</a>
			} else if link {
				<a class="tuc-btn is-ghost is-icon is-sm" href={ templ.SafeURL(s.Href) } aria-label={ t(ctx, "backups.services.open") } title={ t(ctx, "backups.services.open") }>
					@Icon("chevron-right", "size-4")
				</a>
			}
		</td>
	</tr>
}

templ backupHistory(d BackupsData) {
	<section class={ cardClass }>
		@cardHead(t(ctx, "backups.history.title"))
		if len(d.Runs) == 0 {
			@emptyState("history", t(ctx, "backups.history.empty"))
		} else {
			@backupRunsTable(d.Runs, true, d.CanAdmin, d.SudoActive)
		}
	</section>
}

// backupRunsTable lists backups: when, what (the overview) or which kind
// (a service's tab), size and result, and a download for admins (behind
// sudo: the file holds the data).
templ backupRunsTable(runs []BackupRunRow, showLabel, admin, sudo bool) {
	<div class="tuc-table-wrap">
		<table class="tuc-table is-compact w-full">
			<thead>
				<tr>
					<th>{ t(ctx, "backups.history.when") }</th>
					<th>{ t(ctx, "backups.history.what") }</th>
					<th class="is-number">{ t(ctx, "backups.services.size") }</th>
					<th>{ t(ctx, "backups.history.result") }</th>
					<th class="tuc-table__actions"></th>
				</tr>
			</thead>
			<tbody>
				for _, r := range runs {
					<tr>
						<td class="whitespace-nowrap text-muted">{ r.When }</td>
						<td>
							if showLabel {
								<span class="font-mono text-[13px]">{ r.Label }</span>
							} else {
								{ r.Kind }
							}
						</td>
						<td class="is-number whitespace-nowrap">{ r.Size }</td>
						<td>
							<span class="inline-flex flex-wrap items-center gap-1">
								// One badge says it all: tested, sent, running, failed, or
								// what looks wrong with it.
								switch {
									case r.Warning != "":
										<span class="tuc-badge is-warning" title={ r.Warning }>{ r.Warning }</span>
									case r.Verified && r.Tone == "success":
										<span class="tuc-badge is-success" title={ r.Checked }>{ t(ctx, "backups.services.tested_yes") }</span>
									default:
										<span class={ badgeTone(r.Tone) }>{ r.Status }</span>
								}
							</span>
							if r.Error != "" {
								<span class="block max-w-[360px] truncate text-xs text-danger" title={ r.Error }>{ r.Error }</span>
							}
						</td>
						<td class="tuc-table__actions">
							if admin && r.CanLink {
								if sudo {
									<a class="tuc-btn is-ghost is-icon is-sm" href={ templ.SafeURL("/backups/runs/" + r.ID + "/download") } aria-label={ t(ctx, "backups.history.download") } title={ t(ctx, "backups.history.download") }>
										@Icon("download", "size-3.5")
									</a>
								} else {
									<button type="button" class="tuc-btn is-ghost is-icon is-sm" data-tuc-modal="#sudo-dialog" aria-label={ t(ctx, "backups.history.download") } title={ t(ctx, "backups.history.download") }>
										@Icon("download", "size-3.5")
									</button>
								}
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// backupRules tells how to set the bucket up: what the server's credential
// may do and the lifecycle rules that expire old backups.
templ backupRules(d BackupsData) {
	<details class={ cardClass + " group" }>
		<summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-3 text-sm font-semibold">
			@Icon("chevron-right", "size-4 text-muted transition group-open:rotate-90")
			{ t(ctx, "backups.rules.title") }
		</summary>
		<div class={ cardBodyClass + " border-t border-border" }>
			@notice("info", "info", t(ctx, "backups.rules.intro"))
			<div class="tuc-table-wrap">
				<table class="tuc-table is-compact w-full">
					<thead><tr><th>{ t(ctx, "backups.rules.folder") }</th><th>{ t(ctx, "backups.rules.what") }</th><th class="is-number">{ t(ctx, "backups.rules.days") }</th></tr></thead>
					<tbody>
						for _, f := range d.Folders {
							<tr>
								<td class="font-mono">{ f.Folder }/</td>
								<td class="text-muted">{ f.What }</td>
								<td class="is-number">{ fmt.Sprint(f.Days) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="tuc-alert is-info">
				@Icon("shield", "size-4")
				<div class="tuc-alert__body">
					<p class="tuc-alert__title">{ t(ctx, "backups.rules.credential_title") }</p>
					<p>{ t(ctx, "backups.rules.credential") }</p>
				</div>
			</div>
			<p class="m-0 text-[13px] text-muted">{ t(ctx, "backups.rules.cofre") }</p>
			<pre class="m-0 overflow-auto rounded-sm border border-border bg-surface-2 p-3 font-mono text-xs">{ "hangar-cofre setup-bucket" }</pre>
		</div>
	</details>
}

// KitData feeds the recovery kit page.
type KitData struct {
	CSRF         string
	SudoActive   bool
	DefaultLabel string
	Template     string // the kit file text, localized, with {label} {date} {public} {code}
	Error        string
}

// BackupKit generates the recovery kit in the browser (kit.js). Only the
// public key and the hash of the confirmation code are posted.
templ BackupKit(d KitData) {
	@shell(t(ctx, "kit.page_title")) {
		@pageHead(t(ctx, "kit.title"), t(ctx, "kit.subtitle")) {
			<a class="tuc-btn is-ghost" href="/backups">
				@Icon("arrow-right", "size-3.5 rotate-180")
				{ t(ctx, "kit.back") }
			</a>
		}
		@pageBody() {
			@errorAlert(d.Error)
			<div
				id="kit-app"
				class="flex flex-col gap-4"
				data-template={ d.Template }
				data-default-label={ d.DefaultLabel }
				data-locale={ lang(ctx) }
				data-error-crypto={ t(ctx, "kit.error_crypto") }
				data-mismatch={ t(ctx, "kit.mismatch") }
				data-no-key={ t(ctx, "kit.no_key") }
				data-file-ok={ t(ctx, "kit.file_ok") }
				data-qr-label={ t(ctx, "kit.qr_label") }
			>
				<div class="tuc-alert is-danger" id="kit-error" hidden role="alert">
					@Icon("triangle-alert", "size-4")
					<div class="tuc-alert__body"><p data-kit-error-text></p></div>
				</div>
				<div class="tuc-alert is-info">
					@Icon("shield", "size-4")
					<div class="tuc-alert__body">
						<p class="tuc-alert__title">{ t(ctx, "kit.how_title") }</p>
						<p>{ t(ctx, "kit.how") }</p>
					</div>
				</div>
				if !d.SudoActive {
					<section class={ cardClass }>
						@cardHead(t(ctx, "kit.sudo_title"))
						<div class={ cardBodyClass }>
							@sudoForm(d.CSRF, "/backups/kit", t(ctx, "backups.sudo_label"))
						</div>
					</section>
				} else {
					<section class={ cardClass } id="kit-start">
						@cardHead(t(ctx, "kit.step1"))
						<div class={ cardBodyClass }>
							<div class="flex flex-wrap items-end gap-3">
								<div class="flex min-w-[220px] flex-col gap-1.5">
									<label class="tuc-label" for="kit-label">{ t(ctx, "kit.label") }</label>
									<input class="tuc-input" id="kit-label" maxlength="60" value={ d.DefaultLabel }/>
								</div>
								<button class="tuc-btn is-primary" type="button" data-kit-generate>
									@Icon("key-round", "size-3.5")
									{ t(ctx, "kit.generate") }
								</button>
							</div>
							<p class="tuc-hint">{ t(ctx, "kit.label_hint") }</p>
						</div>
					</section>
					<div id="kit-out" class="flex flex-col gap-4" hidden>
						<section class={ cardClass }>
							@cardHead(t(ctx, "kit.step2"))
							<div class={ cardBodyClass }>
								<p class="m-0 text-[13px] text-muted">{ t(ctx, "kit.save_text") }</p>
								<div class="flex flex-col gap-1">
									<span class="tuc-label">{ t(ctx, "kit.public") }</span>
									<code class="font-mono text-xs break-all" id="kit-public"></code>
								</div>
								<div class="flex flex-wrap gap-2">
									<button class="tuc-btn is-primary" type="button" data-kit-download>
										@Icon("download", "size-3.5")
										{ t(ctx, "kit.download") }
									</button>
									<button class="tuc-btn is-outline" type="button" data-kit-print>
										@Icon("printer", "size-3.5")
										{ t(ctx, "kit.print") }
									</button>
								</div>
								<div class="tuc-alert is-warning">
									@Icon("triangle-alert", "size-4")
									<div class="tuc-alert__body"><p>{ t(ctx, "kit.warning") }</p></div>
								</div>
							</div>
						</section>
						<section class={ cardClass }>
							@cardHead(t(ctx, "kit.step3"))
							<form class={ cardBodyClass } method="post" action="/backups/keys" id="kit-register">
								<input type="hidden" name="csrf" value={ d.CSRF }/>
								<input type="hidden" name="label" id="kit-form-label"/>
								<input type="hidden" name="public_key" id="kit-form-public"/>
								<input type="hidden" name="code_hash" id="kit-form-hash"/>
								<label class="tuc-choice">
									<input type="checkbox" class="tuc-check" id="kit-saved" required/>
									<span>{ t(ctx, "kit.saved") }</span>
								</label>
								<p class="tuc-hint">{ t(ctx, "kit.register_hint") }</p>
								<div>
									<button class="tuc-btn is-success" type="submit" id="kit-register-btn" disabled>
										@Icon("shield-check", "size-3.5")
										{ t(ctx, "kit.register") }
									</button>
								</div>
							</form>
						</section>
						// The printed sheet: filled by kit.js, only visible on print.
						<div class="kit-paper" aria-hidden="true">
							<header class="kit-paper__head">
								<div class="kit-paper__brand">
									<span class="kit-paper__logo"><svg width="26" height="26" viewBox="24 24 208 208" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M80 24H176A56 56 0 0 1 232 80V176A56 56 0 0 1 176 232H80A56 56 0 0 1 24 176V80A56 56 0 0 1 80 24ZM84 232V150A44 44 0 0 1 172 150V232Z"></path><path d="M110 196H146V232H110Z"></path></svg></span>
									<span>Hangar</span>
								</div>
								<span class="kit-paper__tag">{ t(ctx, "kit.paper_tag") }</span>
							</header>
							<h1>{ t(ctx, "kit.paper_title") }</h1>
							<p class="kit-paper__lead">{ t(ctx, "kit.paper_text") }</p>
							<dl class="kit-paper__facts">
								<div><dt>{ t(ctx, "kit.paper_label") }</dt><dd id="kit-paper-label"></dd></div>
								<div><dt>{ t(ctx, "kit.paper_date") }</dt><dd id="kit-paper-date"></dd></div>
								<div><dt>{ t(ctx, "kit.paper_code") }</dt><dd id="kit-paper-code" class="kit-paper__mono"></dd></div>
							</dl>
							<section class="kit-paper__key">
								<figure class="kit-paper__qr">
									<div id="kit-paper-qr"></div>
									<figcaption>{ t(ctx, "kit.paper_qr") }</figcaption>
								</figure>
								<div class="kit-paper__secret">
									<div>
										<p class="kit-paper__caption">{ t(ctx, "kit.paper_secret") }</p>
										<p id="kit-paper-secret" class="kit-paper__mono"></p>
									</div>
									<div class="kit-paper__divider"></div>
									<div>
										<p class="kit-paper__caption">{ t(ctx, "kit.paper_public") }</p>
										<p id="kit-paper-public" class="kit-paper__mono kit-paper__small"></p>
									</div>
								</div>
							</section>
							<section class="kit-paper__how">
								<h2>{ t(ctx, "kit.paper_how") }</h2>
								<ol>
									<li>{ t(ctx, "kit.paper_how1") }</li>
									<li>{ t(ctx, "kit.paper_how2") }</li>
									<li>{ t(ctx, "kit.paper_how3") }</li>
								</ol>
							</section>
							<footer class="kit-paper__warn">
								<svg class="kit-paper__warn-icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>
								<span>{ t(ctx, "kit.paper_warn") }</span>
							</footer>
							<pre id="kit-paper-text" hidden></pre>
						</div>
					</div>
				}
			</div>
			<script src={ asset("vendor/qrcode-generator/qrcode.js") } defer></script>
			<script src={ asset("kit.js") } defer></script>
		}
	}
}

// TargetFormData feeds the destination form.
type TargetFormData struct {
	CSRF       string
	SudoActive bool
	Name       string
	Provider   string
	Endpoint   string
	Region     string
	Bucket     string
	Prefix     string
	LockMode   string
	LockDays   string
	PathStyle  bool
	Providers  []string
	Error      string
}

// BackupTargetForm adds a destination. Saving runs the real check
// (write with lock, read, delete refused).
templ BackupTargetForm(d TargetFormData) {
	@shell(t(ctx, "target.page_title")) {
		@pageHead(t(ctx, "target.title"), t(ctx, "target.subtitle")) {
			<a class="tuc-btn is-ghost" href="/backups">
				@Icon("arrow-right", "size-3.5 rotate-180")
				{ t(ctx, "kit.back") }
			</a>
		}
		@pageBody() {
			@errorAlert(d.Error)
			<div class="tuc-alert is-info">
				@Icon("shield", "size-4")
				<div class="tuc-alert__body">
					<p class="tuc-alert__title">{ t(ctx, "target.how_title") }</p>
					<p>{ t(ctx, "target.how") }</p>
				</div>
			</div>
			<section class={ cardClass }>
				@cardHead(t(ctx, "target.form_title"))
				if !d.SudoActive {
					<div class={ cardBodyClass }>
						@sudoForm(d.CSRF, "/backups/targets/new", t(ctx, "backups.sudo_label"))
					</div>
				} else {
					<form class={ cardBodyClass } method="post" action="/backups/targets" autocomplete="off">
						<input type="hidden" name="csrf" value={ d.CSRF }/>
						<div class="grid grid-cols-[repeat(auto-fit,minmax(min(260px,100%),1fr))] gap-3">
							<div class="flex min-w-0 flex-col gap-1.5">
								<label class="tuc-label is-required" for="tg-name">{ t(ctx, "target.name") }</label>
								<input class="tuc-input" id="tg-name" name="name" required maxlength="60" value={ d.Name } placeholder={ t(ctx, "target.name_placeholder") }/>
							</div>
							<div class="flex min-w-0 flex-col gap-1.5">
								<label class="tuc-label" for="tg-provider">{ t(ctx, "target.provider") }</label>
								<select class="tuc-input" id="tg-provider" name="provider" data-tuc-select data-clearable="false">
									for _, p := range d.Providers {
										<option value={ p } selected?={ p == d.Provider }>{ t(ctx, "target.providers." + p) }</option>
									}
								</select>
							</div>
							<div class="flex min-w-0 flex-col gap-1.5">
								<label class="tuc-label is-required" for="tg-endpoint">{ t(ctx, "target.endpoint") }</label>
								<input class="tuc-input font-mono" id="tg-endpoint" name="endpoint" type="url" required value={ d.Endpoint } placeholder="https://s3.us-west-004.backblazeb2.com"/>
								<span class="tuc-hint">{ t(ctx, "target.endpoint_hint") }</span>
							</div>
							<div class="flex min-w-0 flex-col gap-1.5">
								<label class="tuc-label" for="tg-region">{ t(ctx, "target.region") }</label>
								<input class="tuc-input font-mono" id="tg-region" name="region" maxlength="40" value={ d.Region } placeholder="us-west-004"/>
							</div>
							<div class="flex min-w-0 flex-col gap-1.5">
								<label class="tuc-label is-required" for="tg-bucket">{ t(ctx, "target.bucket") }</label>
								<input class="tuc-input font-mono" id="tg-bucket" name="bucket" required maxlength="63" value={ d.Bucket } placeholder="hangar-backups"/>
							</div>
							<div class="flex min-w-0 flex-col gap-1.5">
								<label class="tuc-label" for="tg-prefix">{ t(ctx, "target.prefix") }</label>
								<input class="tuc-input font-mono" id="tg-prefix" name="prefix" maxlength="200" value={ d.Prefix } placeholder="hangar/"/>
								<span class="tuc-hint">{ t(ctx, "target.prefix_hint") }</span>
							</div>
							<div class="flex min-w-0 flex-col gap-1.5">
								<label class="tuc-label is-required" for="tg-access">{ t(ctx, "target.access_key") }</label>
								<input class="tuc-input font-mono" id="tg-access" name="access_key" required maxlength="256"/>
							</div>
							<div class="flex min-w-0 flex-col gap-1.5">
								<label class="tuc-label is-required" for="tg-secret">{ t(ctx, "target.secret_key") }</label>
								<input class="tuc-input font-mono" id="tg-secret" name="secret_key" type="password" required maxlength="256" data-tuc-reveal/>
								<span class="tuc-hint">{ t(ctx, "target.credential_hint") }</span>
							</div>
							<div class="flex min-w-0 flex-col gap-1.5">
								<label class="tuc-label" for="tg-mode">{ t(ctx, "target.lock_mode") }</label>
								<select class="tuc-input" id="tg-mode" name="lock_mode" data-tuc-select data-clearable="false">
									<option value="COMPLIANCE" selected?={ d.LockMode != "GOVERNANCE" }>{ t(ctx, "target.lock_compliance") }</option>
									<option value="GOVERNANCE" selected?={ d.LockMode == "GOVERNANCE" }>{ t(ctx, "target.lock_governance") }</option>
								</select>
							</div>
							<div class="flex min-w-0 flex-col gap-1.5">
								<label class="tuc-label" for="tg-days">{ t(ctx, "target.lock_days") }</label>
								<input class="tuc-input" id="tg-days" name="lock_days" type="number" min="1" max="3650" value={ d.LockDays }/>
								<span class="tuc-hint">{ t(ctx, "target.lock_days_hint") }</span>
							</div>
						</div>
						<label class="tuc-choice">
							<input type="checkbox" class="tuc-check" name="path_style" value="1" checked?={ d.PathStyle }/>
							<span>{ t(ctx, "target.path_style") } <span class="tuc-choice__hint">{ t(ctx, "target.path_style_hint") }</span></span>
						</label>
						<div class="flex justify-end gap-2">
							<a class="tuc-btn is-ghost" href="/backups">{ t(ctx, "tucano.cancel") }</a>
							<button class="tuc-btn is-primary" type="submit">
								@Icon("shield-check", "size-3.5")
								{ t(ctx, "target.save") }
							</button>
						</div>
					</form>
				}
			</section>
		}
	}
}
