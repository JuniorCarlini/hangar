package views

import (
	"fmt"
	"strings"
)

// Frame of every authenticated page, as in the Pista prototype: the top bar
// (brand, search, alerts, lock, account; no breadcrumb), the sidebar (menu,
// server footer) and the page, which opens with pageHead (title and
// actions).

// Shared class strings for the prototype's cards.
const (
	cardClass     = "flex flex-col rounded-md border border-border bg-surface"
	cardHeadClass = "card-head flex flex-wrap items-center gap-2 border-b border-border px-4 py-3"
	cardBodyClass = "flex flex-col gap-3 p-4"
)

templ shell(title string) {
	@layout(title) {
		@topBar(navFrom(ctx))
		@lockBanner(navFrom(ctx))
		@kitCheckBanner(navFrom(ctx))
		<div class="flex min-h-[calc(100vh-48px)] w-full">
			@sidebar(navFrom(ctx))
			<main class="page flex min-w-0 flex-1 flex-col">
				{ children... }
			</main>
		</div>
		if navFrom(ctx).CanCreate {
			@newProjectDialog(navFrom(ctx))
		}
		@commandPalette(navFrom(ctx))
	}
}

// PaletteIcons are the icons the command palette can show. Its items come
// as JSON, so the icons are rendered here once, in a <template>, and
// palette.js clones them by name.
var PaletteIcons = []string{
	"gauge", "globe", "plug", "shield-alert", "wifi", "refresh-cw", "user", "folder", "folder-plus", "plus", "box",
	"layers", "braces", "link", "file-text", "terminal", "settings", "rocket", "rotate-ccw",
	"monitor", "moon", "sun", "log-out", "bell", "database-backup", "users",
}

// lockShortcut is the lock's shortcut for aria-keyshortcuts (ui.js).
func lockShortcut(n Nav) string {
	if n.ModKey == "⌘" {
		return "Meta+Shift+L"
	}
	return "Control+Shift+L"
}

// paletteShortcut is the palette's shortcut for aria-keyshortcuts.
func paletteShortcut(n Nav) string {
	if n.ModKey == "⌘" {
		return "Meta+K"
	}
	return "Control+K"
}

// commandPalette is the ⌘K dialog: a search field over a list of pages,
// projects, services and actions that palette.js fetches from
// /palette.json when it first opens.
templ commandPalette(n Nav) {
	<dialog
		class="tuc-modal is-lg palette"
		id="palette"
		aria-label={ t(ctx, "palette.title") }
		data-src="/palette.json"
		data-csrf={ n.CSRF }
		data-loading={ t(ctx, "palette.loading") }
		data-error={ t(ctx, "palette.error") }
		data-empty={ t(ctx, "palette.empty") }
	>
		<div class="tuc-modal__panel palette__panel">
			<div class="flex items-center gap-2.5 border-b border-border px-4">
				@Icon("search", "size-4 text-muted")
				<input
					class="h-12 min-w-0 grow border-0 bg-transparent text-sm text-fg outline-none placeholder:text-subtle focus-visible:shadow-none"
					id="palette-input"
					type="text"
					role="combobox"
					aria-expanded="true"
					aria-controls="palette-list"
					aria-autocomplete="list"
					aria-label={ t(ctx, "nav.search") }
					autocomplete="off"
					spellcheck="false"
					placeholder={ t(ctx, "palette.placeholder") }
					autofocus
				/>
				<kbd class="shrink-0 rounded-xs border border-border bg-surface-2 px-1.5 font-sans text-[11px] leading-[18px] text-muted">{ "Esc" }</kbd>
			</div>
			<div class="palette__list" id="palette-list" role="listbox" aria-label={ t(ctx, "palette.results") }></div>
			<p class="m-0 px-4 py-8 text-center text-[13px] text-muted" id="palette-status" role="status"></p>
			<div class="flex items-center gap-4 border-t border-border px-4 py-2 text-xs text-subtle">
				<span class="flex items-center gap-1.5"><kbd class="palette__key">{ "↑" }</kbd><kbd class="palette__key">{ "↓" }</kbd>{ t(ctx, "palette.hint_move") }</span>
				<span class="flex items-center gap-1.5"><kbd class="palette__key">{ "↵" }</kbd>{ t(ctx, "palette.hint_run") }</span>
				<span class="flex items-center gap-1.5"><kbd class="palette__key">{ "Esc" }</kbd>{ t(ctx, "palette.hint_close") }</span>
			</div>
		</div>
		<template id="palette-icons">
			for _, name := range PaletteIcons {
				<span data-icon={ name }>
					@Icon(name, "size-4")
				</span>
			}
		</template>
	</dialog>
}

// topBar stays free of page context: brand on the left, search, alerts,
// lock and the account on the right.
templ topBar(n Nav) {
	<header class="topbar sticky top-0 z-20 flex h-12 items-center gap-2 border-b border-border bg-surface px-3 lg:gap-3 lg:pr-6 lg:pl-4">
		<button type="button" class="tuc-btn is-ghost is-icon lg:hidden" data-tuc-drawer="#nav-drawer" aria-label={ t(ctx, "nav.menu_open") }>
			@Icon("menu", "size-5")
		</button>
		<a class="flex shrink-0 items-center gap-2.5 text-fg no-underline hover:text-fg lg:w-[188px]" href="/">
			@brand("")
		</a>
		<span class="grow"></span>
		<button type="button" class="flex h-(--tuc-control-height) min-w-0 shrink cursor-pointer items-center gap-2 rounded-(--tuc-radius-md) border border-border bg-surface-2 text-left text-[13px] text-subtle transition hover:border-border-strong hover:text-muted max-md:w-(--tuc-control-height) max-md:justify-center md:w-[300px] md:pr-1.5 md:pl-2.5" data-palette-open aria-haspopup="dialog" aria-keyshortcuts={ paletteShortcut(n) } aria-label={ t(ctx, "palette.open") }>
			@Icon("search", "size-4 text-muted")
			<span class="min-w-0 grow truncate max-md:hidden">{ t(ctx, "nav.search_placeholder") }</span>
			<kbd class="shrink-0 max-md:hidden rounded-xs border border-border bg-surface px-1.5 font-sans text-[11px] leading-[18px] text-muted">{ n.ModKey }{ "K" }</kbd>
		</button>
		@alertsBell(n)
		@userMenu(n)
	</header>
}

// pageHead is the bar under the top bar: title, subtitle and the page's
// actions.
templ pageHead(title, sub string) {
	<div class="page-head flex min-h-[52px] shrink-0 flex-wrap items-center gap-x-3 gap-y-2 border-b border-border px-4 py-2.5 lg:px-6">
		<h1 class="m-0 text-base leading-6 font-semibold">{ title }</h1>
		if sub != "" {
			<span class="min-w-0 text-xs break-words text-muted">{ sub }</span>
		}
		<span class="grow"></span>
		{ children... }
	</div>
}

// pageBody is the content under the bar, full width.
templ pageBody() {
	<div class="page-body flex w-full min-w-0 flex-col gap-4 p-4 lg:p-6">
		{ children... }
	</div>
}

// card is the prototype's card: a header with the title (and extras on the
// right, passed as children of cardHead) and a body.
templ cardHead(title string) {
	<div class={ cardHeadClass }>
		<h2 class="m-0 text-sm leading-5 font-semibold">{ title }</h2>
		<span class="grow"></span>
		{ children... }
	</div>
}

// notice is an explanation that matters (where alerts go, what a public
// page hides…) shown as an alert box instead of loose small text. tone:
// info, warning, success or danger.
templ notice(tone, icon, text string) {
	<div class={ "tuc-alert is-" + tone }>
		@Icon(icon, "size-4")
		<div class="tuc-alert__body"><p>{ text }</p></div>
	</div>
}

// emptyState is what a list shows when it has nothing: the icon in a small
// raised square, the message and, as children, an optional action.
templ emptyState(icon, text string) {
	<div class="flex flex-col items-center gap-3 px-4 py-8 text-center">
		<span class="inline-flex size-10 items-center justify-center rounded-md border border-border bg-surface-2 text-muted shadow-[0_8px_20px_-8px_rgba(0,0,0,.45)]">
			@Icon(icon, "size-5")
		</span>
		<p class="m-0 max-w-[420px] text-[13px] text-muted">{ text }</p>
		{ children... }
	</div>
}

// userMenu is the account button and its menu: greeting, a 2FA reminder,
// quick theme and language, "My account", lock and logout.
templ userMenu(n Nav) {
	<button type="button" class="flex h-(--tuc-control-height) items-center gap-2 rounded-(--tuc-radius-md) border border-border-strong py-0 pr-2 pl-1 text-left text-fg transition hover:bg-surface-2" data-tuc-dropdown="#user-menu" data-placement="bottom-end" aria-label={ t(ctx, "menu.open") }>
		<span class="relative inline-flex size-7 shrink-0 items-center justify-center rounded-sm bg-accent text-[11px] font-semibold text-on-accent" aria-hidden="true">
			{ navInitials(n) }
			if noTOTP(ctx) {
				<span class="absolute -top-1 -right-1 size-2.5 rounded-[2px] border-2 border-surface bg-warning"></span>
			}
		</span>
		<span class="flex min-w-0 flex-col leading-tight max-sm:hidden">
			<span class="text-[11px] text-muted">{ t(ctx, "menu.hello") }</span>
			<span class="max-w-[140px] truncate text-[13px] font-semibold">{ displayName(n) }</span>
		</span>
		@Icon("chevron-down", "size-3.5 text-muted")
	</button>
	if n.CanLock {
		// Outside the dropdown: Tucano takes a closed dropdown's panel out of
		// the document, and the confirmation (and the shortcut) submit later.
		<form data-confirm={ t(ctx, "confirm.lock.title") } data-confirm-text={ t(ctx, "confirm.lock.text") } data-confirm-ok={ t(ctx, "confirm.lock.ok") } data-tone="danger" method="post" action="/lock" class="hidden" id="lock-form">
			<input type="hidden" name="csrf" value={ n.CSRF }/>
		</form>
	}
	<div class="tuc-dropdown w-[280px]" id="user-menu" hidden>
		<div class="flex items-center gap-3 px-3 pt-3 pb-2.5">
			<span class="inline-flex size-9 shrink-0 items-center justify-center rounded-md bg-accent text-xs font-semibold text-on-accent" aria-hidden="true">{ navInitials(n) }</span>
			<span class="flex min-w-0 flex-col leading-tight">
				<b class="truncate text-sm font-semibold">{ fullName(n) }</b>
				<span class="truncate text-xs text-muted">{ n.Email }</span>
				<span class="truncate text-xs text-subtle">{ t(ctx, "role."+n.Role) } · { n.Host }</span>
			</span>
		</div>
		<hr class="tuc-dropdown__separator"/>
		<a class="tuc-dropdown__item" href="/account">
			<span class="tuc-dropdown__icon">
				@Icon("user", "size-4")
			</span>
			<span class="tuc-dropdown__text">{ t(ctx, "nav.account") }</span>
		</a>
		if noTOTP(ctx) {
			<a class="tuc-dropdown__item bg-warning-soft" href="/account#totp">
				<span class="tuc-dropdown__icon text-warning">
					@Icon("shield-alert", "size-4")
				</span>
				<span class="tuc-dropdown__text">{ t(ctx, "menu.enable_2fa") }</span>
				<span class="tuc-badge is-warning ml-auto">{ t(ctx, "menu.recommended") }</span>
			</a>
		}
		if n.CanLock {
			<button class="tuc-dropdown__item w-full" type="submit" form="lock-form" aria-keyshortcuts={ lockShortcut(n) }>
				<span class="tuc-dropdown__icon">
					@Icon("lock", "size-4")
				</span>
				<span class="tuc-dropdown__text">{ t(ctx, "menu.lock") }</span>
				<span class="tuc-dropdown__shortcut">{ n.ModKey }{ "⇧L" }</span>
			</button>
		}
		<hr class="tuc-dropdown__separator"/>
		<form method="post" action="/account/preferences" class="flex items-center gap-2 px-2.5 py-1">
			<input type="hidden" name="csrf" value={ n.CSRF }/>
			<input type="hidden" name="locale" value={ n.Locale }/>
			<input type="hidden" name="next" value={ n.Path }/>
			<span class="grow text-[13px] text-muted">{ t(ctx, "account.theme") }</span>
			<div class="tuc-btn-group is-segmented" role="radiogroup" aria-label={ t(ctx, "account.theme") }>
				for _, th := range []string{"system", "dark", "light"} {
					<label class="tuc-btn is-sm is-icon" title={ t(ctx, "theme."+th) }>
						<input type="radio" class="tuc-btn__input" name="theme" value={ th } checked?={ n.Theme == th || (n.Theme == "" && th == "system") } aria-label={ t(ctx, "theme."+th) } data-autosubmit/>
						@Icon(ThemeIcon(th), "size-3.5")
					</label>
				}
			</div>
		</form>
		<form method="post" action="/account/preferences" class="flex items-center gap-2 px-2.5 py-1">
			<input type="hidden" name="csrf" value={ n.CSRF }/>
			<input type="hidden" name="theme" value={ n.Theme }/>
			<input type="hidden" name="next" value={ n.Path }/>
			<span class="grow text-[13px] text-muted">{ t(ctx, "account.language") }</span>
			<div class="tuc-btn-group is-segmented" role="radiogroup" aria-label={ t(ctx, "account.language") }>
				for _, l := range Locales() {
					<label class="tuc-btn is-sm px-2.5 text-xs" title={ t(ctx, "locale."+l) }>
						<input type="radio" class="tuc-btn__input" name="locale" value={ l } checked?={ lang(ctx) == l } data-autosubmit/>
						{ localeShort(l) }
					</label>
				}
			</div>
		</form>
		<hr class="tuc-dropdown__separator"/>
		<form data-confirm={ t(ctx, "confirm.logout.title") } data-confirm-text={ t(ctx, "confirm.logout.text") } data-confirm-ok={ t(ctx, "confirm.logout.ok") } data-tone="danger" method="post" action="/logout" class="m-0">
			<input type="hidden" name="csrf" value={ n.CSRF }/>
			<button class="tuc-dropdown__item is-danger w-full" type="submit">
				<span class="tuc-dropdown__icon">
					@Icon("log-out", "size-4")
				</span>
				<span class="tuc-dropdown__text">{ t(ctx, "nav.logout") }</span>
			</button>
		</form>
	</div>
}

// localeShort is the language's code on the toggle (PT, EN).
func localeShort(l string) string {
	code, _, _ := strings.Cut(l, "-")
	return strings.ToUpper(code)
}

// ThemeIcon is the icon of a theme choice (system, dark, light).
func ThemeIcon(th string) string {
	switch th {
	case "dark":
		return "moon"
	case "light":
		return "sun"
	}
	return "monitor"
}

templ navLink(n Nav, key, href, icon, label string) {
	<a class={ navItem(n, key) } href={ templ.SafeURL(href) }>
		<span class="tuc-menu__icon">
			@Icon(icon, "size-4")
		</span>
		{ label }
		{ children... }
	</a>
}

templ sidebar(n Nav) {
	<aside class="sidebar sticky top-12 flex h-[calc(100vh-48px)] w-[232px] shrink-0 flex-col gap-3 overflow-y-auto border-r border-border bg-surface px-2 py-3 max-lg:hidden">
		@sidebarMenu(n)
		@serverFooter(n)
	</aside>
	// On a phone the same menu lives in a drawer opened from the top bar.
	<dialog class="tuc-drawer is-left nav-drawer lg:hidden" id="nav-drawer" aria-label={ t(ctx, "nav.menu") }>
		<div class="tuc-drawer__panel">
			<div class="tuc-drawer__header flex flex-row items-center justify-between gap-3">
				<span class="flex items-center gap-2.5">
					@brand("")
				</span>
				<button type="button" class="tuc-btn is-ghost is-icon is-sm tuc-drawer__close" data-tuc-drawer-close aria-label={ t(ctx, "tucano.close") }>
					@Icon("x", "size-4")
				</button>
			</div>
			<div class="tuc-drawer__body flex min-h-0 flex-col gap-3 overflow-y-auto">
				@sidebarMenu(n)
				@serverFooter(n)
			</div>
		</div>
	</dialog>
}

// sidebarMenu is the menu itself: in the sidebar on a large screen, in the
// nav drawer on a phone.
templ sidebarMenu(n Nav) {
	<nav class="tuc-menu" aria-label={ t(ctx, "nav.menu") }>
			<div class="tuc-menu__section">{ t(ctx, "nav.server") }</div>
			@navLink(n, "overview", "/", "gauge", t(ctx, "nav.overview"))
			// Projects come right after the overview: they are where the daily
			// work happens; the server settings sit below them.
			<div class="tuc-menu__section">{ t(ctx, "nav.projects") }</div>
			for i, p := range n.Projects {
				if i > 0 && !p.Pinned && n.Projects[i-1].Pinned {
					<hr class="tuc-menu__separator"/>
				}
				<div class="group/pin relative">
					<a class={ navItem(n, "p:"+p.Slug) } href={ templ.SafeURL("/p/" + p.Slug) }>
						<span class="tuc-menu__icon">
							<span class="size-2 rounded-xs bg-success" aria-hidden="true"></span>
						</span>
						<span class="truncate">{ p.Slug }</span>
						if p.Pinned {
							<span class="shrink-0 text-subtle" title={ t(ctx, "nav.pinned") }>
								@Icon("pin", "size-3")
							</span>
						}
						<span class="tuc-menu__count group-focus-within/pin:invisible group-hover/pin:invisible">{ fmt.Sprint(p.Services) }</span>
					</a>
					<form method="post" action={ templ.SafeURL("/p/" + p.Slug + "/pin") } class="absolute top-1/2 right-1 m-0 hidden -translate-y-1/2 group-focus-within/pin:block group-hover/pin:block">
						<input type="hidden" name="csrf" value={ n.CSRF }/>
						<input type="hidden" name="next" value={ n.Path }/>
						if p.Pinned {
							<input type="hidden" name="on" value="0"/>
							<button class="tuc-btn is-ghost is-icon is-sm size-6" type="submit" aria-label={ t(ctx, "nav.unpin_named", "project", p.Slug) } title={ t(ctx, "nav.unpin") }>
								@Icon("pin-off", "size-3.5")
							</button>
						} else {
							<input type="hidden" name="on" value="1"/>
							<button class="tuc-btn is-ghost is-icon is-sm size-6" type="submit" aria-label={ t(ctx, "nav.pin_named", "project", p.Slug) } title={ t(ctx, "nav.pin") }>
								@Icon("pin", "size-3.5")
							</button>
						}
					</form>
				</div>
			}
			if n.CanCreate {
				<a class="tuc-btn is-outline mt-1.5 w-full" href="/?new=1" data-tuc-modal="#new-project">
					@Icon("folder-plus", "size-3.5")
					{ t(ctx, "nav.new_project") }
				</a>
			}
			<hr class="tuc-menu__separator"/>
			if !n.Limited {
				<div class="tuc-menu__section">{ t(ctx, "nav.section_access") }</div>
				@navLink(n, "domains", "/domains", "globe", t(ctx, "nav.domains"))
				@navLink(n, "ports", "/ports", "plug", t(ctx, "nav.ports")) {
					if n.PortsOpen > 0 {
						<span class="tuc-menu__count"><span class="tuc-badge is-warning is-plain">{ fmt.Sprint(n.PortsOpen) }</span></span>
					}
				}
				if n.CanStatus {
					@navLink(n, "status-links", "/status-links", "wifi", t(ctx, "nav.status_links"))
				}
				<div class="tuc-menu__section">{ t(ctx, "nav.section_ops") }</div>
				if n.CanStatus {
					@navLink(n, "git-credentials", "/git-credentials", "key-round", t(ctx, "nav.git_credentials"))
				}
				@navLink(n, "backups", "/backups", "database-backup", t(ctx, "nav.backups")) {
					if n.BackupAlerts > 0 {
						<span class="tuc-menu__count"><span class="tuc-badge is-danger is-plain">{ fmt.Sprint(n.BackupAlerts) }</span></span>
					}
				}
				@navLink(n, "updates", "/updates", "shield-alert", t(ctx, "nav.updates")) {
					if n.VulnCritical > 0 {
						<span class="tuc-menu__count"><span class="tuc-badge is-danger is-plain">{ fmt.Sprint(n.VulnCritical) }</span></span>
					} else if n.VulnSecurity > 0 {
						<span class="tuc-menu__count"><span class="tuc-badge is-warning is-plain">{ fmt.Sprint(n.VulnSecurity) }</span></span>
					}
				}
				@navLink(n, "alerts", "/alerts", "bell", t(ctx, "nav.alerts"))
			}
			if n.CanStatus || n.IsOwner {
				<div class="tuc-menu__section">{ t(ctx, "nav.section_system") }</div>
				if n.CanStatus {
					@navLink(n, "brand", "/brand", "palette", t(ctx, "nav.brand"))
				}
				if n.IsOwner {
					@navLink(n, "team", "/team", "users", t(ctx, "nav.team"))
					@navLink(n, "update", "/update", "refresh-cw", t(ctx, "nav.update")) {
						if n.Update {
							<span class="tuc-menu__count"><span class="tuc-badge is-info is-plain">1</span></span>
						}
					}
				}
			}
		</nav>
}

// serverFooter is the server's IP (copied with a click) and the Hangar
// version at the bottom of the sidebar; the load lives in the overview.
templ serverFooter(n Nav) {
	<div class="mt-auto flex flex-col gap-2 border-t border-border px-2 pt-3 text-xs text-muted">
		if n.ServerIP != "" {
			<button type="button" class="flex w-full items-center gap-2 rounded-sm border border-border bg-surface-2 px-2 py-1.5 text-left text-fg hover:border-border-strong" data-copy={ n.ServerIP } data-copied={ t(ctx, "nav.ip_copied") } aria-label={ t(ctx, "nav.ip_copy", "ip", n.ServerIP) } title={ t(ctx, "nav.ip_copy", "ip", n.ServerIP) }>
				@Icon("map-pin", "size-3.5 shrink-0 text-muted")
				<span class="grow truncate font-mono text-xs">{ n.ServerIP }</span>
				@Icon("copy", "size-3.5 shrink-0 text-muted")
			</button>
		}
		if n.IsOwner {
			<a class="flex items-center justify-center gap-2 rounded-sm px-2 py-1 text-muted no-underline hover:bg-surface-2 hover:text-fg" href="/update" title={ t(ctx, "nav.update") }>
				<span class="font-mono">{ n.Version }</span>
				if n.Update {
					<span class="tuc-badge is-accent">{ t(ctx, "nav.new_version") }</span>
				}
			</a>
		} else {
			<span class="px-2 py-1 text-center font-mono">{ n.Version }</span>
		}
	</div>
}

// newProjectDialog creates a project from anywhere (the sidebar button).
templ newProjectDialog(n Nav) {
	<dialog class="tuc-modal is-md" id="new-project" aria-labelledby="new-project-title" data-open={ fmt.Sprint(n.NewProject.Open) }>
		<div class="tuc-modal__panel">
			<div class="tuc-modal__header">
				<h2 class="tuc-modal__title" id="new-project-title">{ t(ctx, "projects.new") }</h2>
				<button type="button" class="tuc-btn is-ghost is-icon is-sm tuc-modal__close" data-tuc-modal-close aria-label={ t(ctx, "tucano.close") }>
					@Icon("x", "size-4")
				</button>
			</div>
			<form method="post" action="/projects" class="tuc-modal__body flex flex-col gap-4">
				<input type="hidden" name="csrf" value={ n.CSRF }/>
				@errorAlert(n.NewProject.Error)
				<div class="flex min-w-0 flex-col gap-1.5">
					<label class="tuc-label" for="np-name">{ t(ctx, "projects.form.name") }</label>
					<input class="tuc-input" id="np-name" name="name" required maxlength="80" autofocus autocomplete="off" placeholder={ t(ctx, "projects.form.name_placeholder") } value={ n.NewProject.Name } data-slug-preview="#np-slug-out"/>
					<span class="tuc-hint">{ t(ctx, "projects.form.slug_hint") } <span class="font-mono"><span id="np-slug-out" data-empty="lab">lab</span>_web</span></span>
				</div>
				<div class="flex justify-end gap-2">
					<button type="button" class="tuc-btn is-ghost" data-tuc-modal-close>{ t(ctx, "tucano.cancel") }</button>
					<button class="tuc-btn is-primary" type="submit">
						@Icon("folder-plus", "size-3.5")
						{ t(ctx, "projects.form.submit") }
					</button>
				</div>
			</form>
		</div>
	</dialog>
}
