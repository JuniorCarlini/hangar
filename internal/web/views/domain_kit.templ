package views

import "context"

// The code the app runs to show each customer its ownership TXT; it must
// match edge.OwnershipCode (domain_kit_test.go checks the Python one).
const (
	txtSnippetPython = `import hashlib, hmac, os

def hangar_txt(domain):
    secret = os.environ["HANGAR_DOMAIN_CHECK_SECRET"].encode()
    mac = hmac.new(secret, ("txt|" + domain).encode(), hashlib.sha256)
    return "hg-" + mac.hexdigest()[:12]`
	txtSnippetNode = `const crypto = require("crypto");

function hangarTxt(domain) {
  const mac = crypto.createHmac("sha256", process.env.HANGAR_DOMAIN_CHECK_SECRET);
  mac.update("txt|" + domain);
  return "hg-" + mac.digest("hex").slice(0, 12);
}`
	txtSnippetPHP = `function hangar_txt(string $domain): string {
    $mac = hash_hmac("sha256", "txt|" . $domain, getenv("HANGAR_DOMAIN_CHECK_SECRET"));
    return "hg-" . substr($mac, 0, 12);
}`
)

func checkRequest(path string) string {
	return "GET " + path + "?domain=loja.cliente.com.br\n" +
		"X-Hangar-Timestamp: 1793044163\n" +
		"X-Hangar-Signature: hex(HMAC-SHA256(HANGAR_DOMAIN_CHECK_SECRET, \"loja.cliente.com.br|1793044163\"))"
}

// customerText is the DNS a customer creates, ready to show in the app.
func customerText(ctx context.Context, d DomainsSection) string {
	host, code := "loja.cliente.com.br", "hg-…"
	entry := d.EntryHost
	if entry == "" {
		entry = "—"
	}
	s := t(ctx, "domain.kit.text_intro", "domain", host) + "\n" +
		"  CNAME  " + host + "  →  " + entry + "\n"
	if d.RequireTXT {
		s += "  TXT    _hangar." + host + "  →  " + code + "\n"
	}
	return s + t(ctx, "domain.kit.text_cloudflare") + "\n" + t(ctx, "domain.kit.text_https")
}

// domainKit is the "how it works" of the customer domains: what the app
// needs to take them (the signed check it answers, the ownership TXT code it
// shows) and the text for the customer.
templ domainKit(d ServiceData) {
	<dialog class="tuc-modal is-lg" id="domain-kit" aria-labelledby="domain-kit-title">
		<div class="tuc-modal__panel">
			<div class="tuc-modal__header">
				<h2 class="tuc-modal__title" id="domain-kit-title">{ t(ctx, "domain.kit.title") }</h2>
				<button type="button" class="tuc-btn is-ghost is-icon is-sm tuc-modal__close" data-tuc-modal-close aria-label={ t(ctx, "tucano.close") }>
					@Icon("x", "size-4")
				</button>
			</div>
			<div class="tuc-modal__body flex flex-col gap-5">
				<p class="tuc-modal__text">{ t(ctx, "domain.kit.intro") }</p>
				<section class="flex flex-col gap-2">
					<h3 class="text-sm font-semibold">{ t(ctx, "domain.kit.step_check") }</h3>
					<p class="text-[13px] text-muted">{ t(ctx, "domain.kit.step_check_hint") }</p>
					<pre class="overflow-x-auto rounded-sm border border-border bg-surface-2 px-3 py-2.5 font-mono text-xs leading-[18px]">{ checkRequest(d.Domains.CheckPath) }</pre>
				</section>
				<section class="flex flex-col gap-2">
					<h3 class="text-sm font-semibold">{ t(ctx, "domain.kit.step_txt") }</h3>
					<p class="text-[13px] text-muted">{ t(ctx, "domain.kit.step_txt_hint") }</p>
					<div class="tuc-tabs" data-tuc-tabs>
						<div class="tuc-tabs__list">
							for i, lang := range []string{"Python", "Node", "PHP"} {
								<button type="button" class="tuc-tabs__tab" aria-selected={ boolAttr(i == 0) }>{ lang }</button>
							}
						</div>
						for i, code := range []string{txtSnippetPython, txtSnippetNode, txtSnippetPHP} {
							<div class="tuc-tabs__panel pt-3" hidden?={ i != 0 }>
								<pre class="overflow-x-auto rounded-sm border border-border bg-surface-2 px-3 py-2.5 font-mono text-xs leading-[18px]">{ code }</pre>
							</div>
						}
					</div>
				</section>
				<section class="flex flex-col gap-2">
					<h3 class="text-sm font-semibold">{ t(ctx, "domain.kit.step_text") }</h3>
					<p class="text-[13px] text-muted">{ t(ctx, "domain.kit.step_text_hint") }</p>
					<pre class="overflow-x-auto rounded-sm border border-border bg-surface-2 px-3 py-2.5 font-mono text-xs leading-[18px] whitespace-pre-wrap">{ customerText(ctx, d.Domains) }</pre>
					<div class="flex justify-end">
						<button type="button" class="tuc-btn is-outline is-sm" data-copy={ customerText(ctx, d.Domains) } data-copied={ t(ctx, "common.copied") }>
							@Icon("copy", "size-3.5")
							{ t(ctx, "domain.kit.copy_text") }
						</button>
					</div>
				</section>
			</div>
		</div>
	</dialog>
}
